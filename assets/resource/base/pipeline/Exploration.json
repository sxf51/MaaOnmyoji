{
    "ExplorationTask": {
        "doc": "$exploration_task_doc",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountInit",
                "custom_action_param": {
                    "target_count": 10
                }
            }
        },
        "next": [
            "ExplorationRun"
        ]
    },
    "ExplorationRun": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ExploreBattles"
            }
        },
        "next": [
            "ExplorationFinish"
        ]
    },
    "ExplorationSelectChapter": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "第二十八章",
                "roi": [
                    1056,
                    204,
                    212,
                    365
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        }
    },
    "ExplorationEnterChapter": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^探索$",
                "roi": [
                    1061,
                    573,
                    156,
                    92
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        }
    },
    "ExplorationFindEnemy": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Exploration/Enemy.png",
                "roi": [
                    100,
                    120,
                    1170,
                    478
                ],
                "threshold": 0.78
            }
        },
        "action": "Click"
    },
    "ExplorationProgress": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountProgress",
                "custom_action_param": {
                    "count": 1
                }
            }
        }
    },
    "ExplorationFinish": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountFinish"
            }
        }
    }
}
