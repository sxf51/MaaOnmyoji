    "ExplorationTicketThreshold": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "可选：在探索地图、章节入口或章节内战场读到突破券达到所选数量时结束探索，避免券满后继续掉落被浪费；默认关闭。战场内在每场结算并计数后、找下一只怪前判断，正在进行的战斗不打断；结束本身不增加成功次数。各页面的读数区域取自 runhey/OnmyojiAutoScript@2d2f6d8962a5af17c95670c5d0fb2e384b247162 tasks/Exploration/assets.py 与 TanyaShue/MaaYYs@3f9a969 resource_pack/base/pipeline/战斗/kun28.json，两者相互印证。只结束探索，不自动切换任务、不关闭加成。",
        "enabled": false,
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "ExplorationTicketMap",
                    "ExplorationTicketEntrance",
                    "ExplorationTicketField"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "ExplorationFinish",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
