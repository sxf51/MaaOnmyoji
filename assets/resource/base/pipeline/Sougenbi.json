{
    "SougenbiTask": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "导航到业原火并选择配置的阵（默认痴之阵），按成功结算次数重复挑战；达到次数或所选阵的挑战券清零时结束。不检查体力、不开加成；业原火只能单人。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountInit",
                "custom_action_param": {
                    "target_count": 10
                }
            }
        },
        "next": [
            "SougenbiNavigate",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
    "SougenbiNavigate": {
        "doc": "从当前页面进入业原火层数页（御魂菜单→业原火，或从八岐大蛇等御魂页签切换）。",
        "next": [
            "NativeNavigationBlocked",
            "[JumpBack]NativeResultDismiss",
            "[JumpBack]NativeDailyRewardPopup",
            "[JumpBack]NativeNavCancelNoResource",
            "[JumpBack]NativeNavConfirmExitExplore",
            "[JumpBack]NativeNavConfirmExitTeam",
            "[JumpBack]NativeNavDismissRaidTarget",
            "[JumpBack]NativeNavCancelInvite",
            "[JumpBack]NativeNavCancelCreate",
            "[JumpBack]NativeLoading",
            "SougenbiNavigationReady",
            "[JumpBack]NavigateSougenbi",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "timeout": 60000
    },
    "SougenbiNavigationReady": {
        "doc": "进入业原火层数页后选择配置的阵。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageSougenbiStage"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "SougenbiSearchLayer"
        ]
    },
    "SougenbiLayerText": {
        "doc": "识别配置的阵名（贪之阵/嗔之阵/痴之阵，一屏可见无需滚动）；ROI 避开左侧鸟居图标；由“业原火难度”选项改写。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^痴之阵$",
                "roi": [
                    128,
                    95,
                    140,
                    270
                ]
            }
        }
    },
    "SougenbiLayerSelected": {
        "doc": "确认目标阵名文字及红色选中背景；由“业原火难度”选项改写。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageSougenbiStage",
                    {
                        "sub_name": "SougenbiSelectedLayerText",
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "^痴之阵$",
                                "roi": [
                                    128,
                                    95,
                                    140,
                                    270
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": "SougenbiSelectedLayerText",
                                "roi_offset": [
                                    -28,
                                    -8,
                                    60,
                                    16
                                ],
                                "method": 4,
                                "lower": [
                                    120,
                                    15,
                                    10
                                ],
                                "upper": [
                                    255,
                                    110,
                                    100
                                ],
                                "count": 120
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        }
    },
    "SougenbiSearchLayer": {
        "doc": "查找配置层数；选中后才进入战前准备。",
        "next": [
            "SougenbiLayerReady",
            "SougenbiSelectLayer",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "timeout": 20000
    },
    "SougenbiLayerReady": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "已确认目标层数选中，开始战前准备。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "SougenbiLayerSelected"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "SougenbiPreparation"
        ]
    },
    "SougenbiSelectLayer": {
        "doc": "点击配置的阵。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageSougenbiStage",
                    "SougenbiLayerText"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": [
            "SougenbiSearchLayer"
        ],
        "pre_delay": 0,
        "post_delay": 1000,
        "pre_wait_freezes": 0,
        "on_error": [],
        "max_hit": 3
    },
    "SougenbiPreparation": {
        "doc": "按顺序进入首个启用的准备步骤；选项关闭的步骤由 enabled 原生跳过。业原火不做加成步骤。",
        "action": "DoNothing",
        "next": [
            "SougenbiLockTeam",
            "SougenbiPreset",
            "SougenbiBattleEntry",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
    "SougenbiLockTeam": {
        "doc": "确认阵容锁定；未锁定时点击锁图标。",
        "next": [
            "SougenbiLockedTeam",
            "[JumpBack]SougenbiUnlockTeam",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "action": "DoNothing"
    },
    "SougenbiLockedTeam": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Common/FormationLocked.png",
                "roi": [
                    680,
                    645,
                    80,
                    65
                ],
                "threshold": 0.9
            }
        },
        "action": "DoNothing",
        "next": [
            "SougenbiPreset",
            "SougenbiBattleEntry",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
    "SougenbiUnlockTeam": {
        "doc": "点击未锁定图标，锁定业原火阵容。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageSougenbiStage",
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "Common/FormationUnlocked.png",
                                "roi": [
                                    680,
                                    645,
                                    80,
                                    65
                                ],
                                "threshold": 0.9
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": [],
        "pre_delay": 0,
        "post_delay": 1000,
        "pre_wait_freezes": 0,
        "on_error": [],
        "max_hit": 3
    },
    "SougenbiPreset": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "配置本任务的预设页面与返回位置，完成换队后才继续准备。",
        "enabled": false,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "NodeOverride",
                "custom_action_param": {
                    "TeamPresetContext": {
                        "recognition": {
                            "type": "And",
                            "param": {
                                "all_of": [
                                    "PageSougenbiStage"
                                ]
                            }
                        }
                    },
                    "TeamPresetEntryText": {
                        "recognition": {
                            "param": {
                                "roi": [
                                    728,
                                    605,
                                    103,
                                    40
                                ]
                            }
                        }
                    },
                    "TeamPresetOpen": {
                        "action": {
                            "param": {
                                "target": [
                                    750,
                                    558,
                                    52,
                                    50
                                ]
                            }
                        }
                    }
                }
            }
        },
        "anchor": {
            "TeamPresetReturn": "SougenbiPresetDone"
        },
        "next": [
            "TeamPresetRun"
        ]
    },
    "SougenbiPresetDone": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "确认预设已应用并返回挑战页，开始挑战。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageSougenbiStage"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "SougenbiBattleEntry",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
    "SougenbiTicketEmpty": {
        "doc": "所选阵的挑战券为 0。三种券分别显示在顶部（贪/嗔/痴），ROI 只框数字、避开券图标（框进图标时“0”会被读成“C”）；由“业原火难度”选项改写。only_rec：直接识别 ROI，不走整屏批量 OCR 的检测缓存（实测批量检测会漏掉顶部单个“0”，导致券已为 0 仍去点挑战）。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^0$",
                "roi": [
                    948,
                    16,
                    90,
                    38
                ],
                "only_rec": true
            }
        }
    },
    "SougenbiNoTicket": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "挑战前在层数页确认所选阵的挑战券已清零，正常结束任务（不视为失败）。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageSougenbiStage",
                    "SougenbiTicketEmpty"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "SougenbiFinish",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
    "SougenbiNoTicketToast": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "兜底：挑战券为 0 时点击挑战，游戏不弹窗，只在画面中部显示会自动消失的提示“需要贪念之卷才能进行挑战，贪念之卷可以在御魂副本的挑战中获得。”（实机截图，嗔/痴同理）。识别到即正常结束，无需关闭。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "之卷才能进行挑战",
                "roi": [
                    180,
                    210,
                    940,
                    65
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "SougenbiFinish",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
    "SougenbiBattleEntry": {
        "doc": "开始一场新挑战前重置点击重试上限；所选阵挑战券清零时结束。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ResetCount",
                "custom_action_param": {
                    "nodes": [
                        "SougenbiChallenge",
                        "CommonBattleEnableAuto",
                        "CommonNetworkRetry",
                        "CommonRewardOverflow",
                        "MitamaTreasurePopup",
                        "CommonBattleMark",
                        "DailyPrepare",
                        "SougenbiBattleResult",
                        "CommonBattleWait",
                        "CommonBattleEnteringWait",
                        "CommonCutscene",
                        "DailyRewardPopup",
                        "CommonRewardItemDetail",
                        "CommonSoulMismatch",
                        "CommonSoulMismatchConfirm"
                    ]
                }
            }
        },
        "next": [
            "SougenbiNoTicket",
            "SougenbiNoTicketToast",
            "SougenbiChallenge",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "anchor": {
            "CommonBattleAuto": "CommonBattleEnableAuto"
        }
    },
    "SougenbiChallengeButton": {
        "doc": "业原火挑战按钮（文字约 x1037-1164, y585-649）比八岐大蛇层数页的挑战按钮更靠左，ROI 单独设置。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^挑战$",
                "roi": [
                    1020,
                    560,
                    200,
                    150
                ]
            }
        }
    },
    "SougenbiChallenge": {
        "doc": "确认业原火阵已选中和挑战按钮后开始战斗。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "SougenbiLayerSelected",
                    "SougenbiChallengeButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": [
            "SougenbiWaitBattleStart"
        ],
        "pre_delay": 0,
        "post_delay": 1000,
        "pre_wait_freezes": 0,
        "on_error": [],
        "max_hit": 3
    },
    "SougenbiWaitBattleStart": {
        "doc": "等待过场、布阵载入、准备、正式战斗或结算；挑战券为 0 时（提示或计数）正常结束；仅原挑战目标仍存在时允许有界重试。",
        "next": [
            "SougenbiNoTicketToast",
            "SougenbiBattleStarted",
            "[JumpBack]CommonSoulMismatch",
            "SougenbiNoTicket",
            "SougenbiChallenge",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "timeout": 60000
    },
    "SougenbiBattleStarted": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "已进入准备、战斗或结算，转入战斗处理。",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "DailyPrepare",
                    "PageBattle",
                    "DailyBattleResult",
                    "DailyBattleFailed",
                    "MitamaTreasurePopup",
                    "PageLoading",
                    "PageBattleEntering"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "SougenbiBattle"
        ],
        "anchor": {
            "CommonBattleAuto": "CommonBattleEnableAuto"
        }
    },
    "SougenbiBattle": {
        "doc": "处理准备、自动战斗、结算与特殊奖励，不将等待画面计为胜利。",
        "next": [
            "[JumpBack][Anchor]CommonBattleAuto",
            "[JumpBack]CommonBattleMark",
            "[JumpBack]CommonBattleWait",
            "[JumpBack]MitamaTreasurePopup",
            "SougenbiBattleFailure",
            "[JumpBack]CommonRewardItemDetail",
            "[JumpBack]CommonRewardOverflow",
            "SougenbiBattleResult",
            "[JumpBack]CommonBattleEnteringWait",
            "[JumpBack]CommonSoulMismatch",
            "[JumpBack]DailyPrepare",
            "[JumpBack]DailyRewardPopup",
            "[JumpBack]CommonNetworkRetry",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "timeout": 180000,
        "pre_delay": 0,
        "post_delay": 0
    },
    "SougenbiBattleResult": {
        "doc": "关闭业原火成功结算，等待返回所选阵。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DailyBattleResult"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": [
            "[JumpBack]MitamaTreasurePopup",
            "SougenbiBattleFailure",
            "SougenbiBattleResult",
            "[JumpBack]DailyRewardPopup",
            "SougenbiAfterResult",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "pre_delay": 0,
        "post_delay": 600,
        "pre_wait_freezes": 0,
        "on_error": [],
        "post_wait_freezes": 0,
        "max_hit": 5
    },
    "SougenbiAfterResult": {
        "doc": "确认成功结算已返回业原火所选阵后，累计成功次数并决定继续或收尾。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageSougenbiStage",
                    "SougenbiLayerSelected"
                ],
                "box_index": 0
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountProgress",
                "custom_action_param": {
                    "count": 1,
                    "continue_node": "SougenbiBattleEntry",
                    "finish_node": "SougenbiFinish"
                }
            }
        },
        "next": [
            "SougenbiBattleEntry"
        ],
        "pre_delay": 0,
        "post_delay": 0
    },
    "SougenbiFinish": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "达到成功次数或挑战券清零后结束，停留在业原火层数页。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountFinish"
            }
        }
    },
    "SougenbiBattleFailure": {
        "doc": "战斗失败进入独立退出路径，不增加成功次数。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DailyBattleFailed"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "SougenbiFailedBattleResult",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "timeout": 30000
    },
    "SougenbiFailedBattleResult": {
        "doc": "关闭业原火失败结算，返回后停止任务。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DailyBattleResult"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": [
            "SougenbiFailedReturn",
            "SougenbiFailedBattleResult",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "pre_delay": 0,
        "post_delay": 1500,
        "pre_wait_freezes": 0,
        "on_error": [],
        "max_hit": 5
    },
    "SougenbiFailedReturn": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "返回业原火层数页后以失败结束。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageSougenbiStage"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
