    "CommonBattleMark": {
        "doc": "仅在正式战斗识别成立后，按用户配置站位点击友方绿标；每场最多一次，过场与准备页不点。 参考 runhey/OnmyojiAutoScript@2d2f6d8962a5af17c95670c5d0fb2e384b247162 的 tasks/Component/GeneralBattle/battle_wait.py::_bw_green_default，仅采用每场一次和按站位选中的思路；本项目使用原生Pipeline与InputTarget，不引入其模糊名称匹配或随机战斗输入。站位范围结合本地1280x720战斗截图缩小，仍需实机核验镜头变化。",
        "enabled": false,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageBattle"
                ],
                "box_index": 0
            }
        },
        "action": "DoNothing",
        "max_hit": 1,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CommonBattleMark"
        ]
    },
    "AwakeningAbortOpenType": {
        "doc": "异常收尾从觉醒菜单打开火麒麟层数页，只用于关闭全局觉醒材料加成。",
