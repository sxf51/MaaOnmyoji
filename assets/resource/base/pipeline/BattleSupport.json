    "BattleCleanupWait": {
        "pre_delay": 0,
        "doc": "异常收尾期间只等待正式战斗；原生命中上限180次，每次等待1秒。预算耗尽后无法再命中，交由清理流程失败退出。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageBattle"
                ]
            }
        },
        "action": "DoNothing",
        "max_hit": 180,
        "post_delay": 1000,
        "next": []
    },
    "BattleCleanupResourcePending": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "资源不足弹窗在有限取消重试后仍未关闭时停止清理，不操作其后方的副本页面。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageNoResource"
                ]
            }
