{
    "CurrentActivityTask": {
        "desc": "通用：重复挑战",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountInit",
                "custom_action_param": {
                    "target_count": -1
                }
            }
        },
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "CurrentActivityInsufficientAP",
            "CurrentActivityBattleFailure",
            "[JumpBack]CommonBattleEnteringWait",
            "[JumpBack]CommonCutscene",
            "SafeInput_CurrentActivityBattleResult",
            "[JumpBack]CurrentActivityPrepare",
            "[JumpBack]CommonClickAuto",
            "[JumpBack]CurrentActivityChallenging",
            "CurrentActivityBeforeChallenge"
        ],
        "timeout": 180000
    },
    "CurrentActivityChallenge": {
        "desc": "重复挑战：点击挑战",
        "timeout": 180000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1067,
                    564,
                    212,
                    154
                ],
                "expected": [
                    "^挑战$",
                    "^搜寻$",
                    "^开启$"
                ]
            }
        },
        "action": "DoNothing",
        "post_delay": 0,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CurrentActivityChallenge"
        ],
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "点击当前活动的挑战按钮，开始一轮重复挑战。"
    },
    "CurrentActivityPrepare": {
        "desc": "重复挑战：准备",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1083,
                    526,
                    180,
                    131
                ],
                "expected": [
                    "^准备$"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "CurrentActivityPreparationPassed",
            "[JumpBack]CommonBattleEnteringWait",
            "SafeInput_CurrentActivityPrepare"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "点击当前活动战斗中的准备按钮。"
    },
    "CurrentActivityChallenging": {
        "desc": "重复挑战：挑战中",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageBattle"
                ]
            }
        },
        "action": "DoNothing",
        "next": []
    },
    "CurrentActivityBattleResult": {
        "desc": "重复挑战：点击屏幕继续",
        "timeout": 20000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    440,
                    637,
                    400,
                    82
                ],
                "expected": [
                    "^点击(屏幕|空白区域)继续$"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CurrentActivityBattleResult"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "关闭成功结算，返回挑战页后再记录成功次数。"
    },
    "CurrentActivityFinishOnce": {
        "desc": "重复挑战：完成一次挑战",
        "timeout": 20000,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CurrentActivityChallenge"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountProgress",
                "custom_action_param": {
                    "count": 1,
                    "continue_node": "CurrentActivityPreparation",
                    "finish_node": "CurrentActivityFinish"
                }
            }
        },
        "next": [
            "CurrentActivityPreparation"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "确认成功结算已返回挑战页后，累计次数并决定继续准备或结束；后续仍检查未完成的队伍预设。"
    },
    "CurrentActivityComplete": {
        "desc": "重复挑战：记录一次成功挑战",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountProgress",
                "custom_action_param": {
                    "count": 1
                }
            }
        },
        "next": [
            "CurrentActivityCountDetermine"
        ]
    },
    "CurrentActivityCountDetermine": {
        "desc": "重复挑战：判断是否继续挑战",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountDetermine",
                "custom_action_param": {
                    "decision_node": "CurrentActivityCountDetermine",
                    "continue_node": "CurrentActivityBeforeChallenge",
                    "finish_node": "CurrentActivityFinish"
                }
            }
        },
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "[JumpBack]SafeInput_CurrentActivityBattleResult",
            "CurrentActivityBeforeChallenge"
        ]
    },
    "CurrentActivityInsufficientAP": {
        "desc": "重复挑战：体力或代币不足时结束",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonInsufficientAP"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "CurrentActivityFinish"
        ]
    },
    "CurrentActivityFinish": {
        "desc": "重复挑战：达到目标次数后结束",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountFinish"
            }
        }
    },
    "CurrentActivityBattleFailure": {
        "desc": "识别战斗失败，进入独立收尾，不累计成功次数。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DailyBattleFailed"
                ]
            }
        },
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CurrentActivityFailedBattleResult"
        ],
        "timeout": 30000
    },
    "CurrentActivityFailedBattleResult": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CurrentActivityBattleResult"
                ]
            }
        },
        "action": "DoNothing",
        "post_delay": 0,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CurrentActivityFailedBattleResult"
        ],
        "timeout": 30000,
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "关闭失败结算，返回挑战页后停止重复挑战。"
    },
    "CurrentActivityFailedReturn": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CurrentActivityFinishOnce"
                ]
            }
        },
        "next": [
            "NativeFlowFailed"
        ]
    },
    "CurrentActivityPreparationPassed": {
        "doc": "自动准备已进入战斗或结算时，返回重复挑战流程。",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "CurrentActivityChallenging",
                    "CurrentActivityBattleResult",
                    "DailyBattleFailed"
                ]
            }
        },
        "action": "DoNothing",
        "next": []
    },
    "CurrentActivityPreset": {
        "doc": "配置本任务的预设页面与返回位置，完成换队后才继续准备。",
        "enabled": false,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "NodeOverride",
                "custom_action_param": {
                    "TeamPresetContext": {
                        "recognition": {
                            "type": "And",
                            "param": {
                                "all_of": [
                                    "CurrentActivityChallenge"
                                ]
                            }
                        }
                    },
                    "TeamPresetEntryText": {
                        "recognition": {
                            "param": {
                                "roi": [
                                    728,
                                    605,
                                    103,
                                    40
                                ]
                            }
                        }
                    },
                    "SafeInput_TeamPresetOpen": {
                        "action": {
                            "param": {
                                "target": [
                                    750,
                                    558,
                                    52,
                                    50
                                ]
                            }
                        }
                    }
                }
            }
        },
        "anchor": {
            "TeamPresetReturn": "CurrentActivityPresetDone"
        },
        "next": [
            "TeamPresetRun"
        ]
    },
    "CurrentActivityPresetDone": {
        "doc": "确认预设已应用并返回挑战页，禁用本次换队步骤。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CurrentActivityChallenge"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DisableNode",
                "custom_action_param": {
                    "node_name": "CurrentActivityPreset"
                }
            }
        },
        "next": [
            "CurrentActivityPreparation"
        ]
    },
    "CurrentActivityPreparation": {
        "doc": "只在开战前完成本次启用的队伍预设。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SubTask",
                "custom_action_param": {
                    "sub": [
                        "CurrentActivityPreset"
                    ],
                    "completion_next": [
                        "SafeInput_CurrentActivityChallenge"
                    ],
                    "timeout": 180000
                }
            }
        },
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CurrentActivityChallenge"
        ],
        "timeout": 180000,
        "pre_delay": 0,
        "post_delay": 0
    },
    "CurrentActivityBeforeChallenge": {
        "doc": "确认挑战页后执行未完成的队伍预设准备。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CurrentActivityChallenge"
                ]
            }
        },
        "next": [
            "CurrentActivityPreparation"
        ]
    }
}
