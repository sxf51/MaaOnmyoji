            "TeamLeaderInviteListAtBottom",
            "TeamLeaderInviteRememberList",
            "TeamLeaderInviteAdvance"
        ],
        "timeout": 20000
    },
    "TeamLeaderInviteListAtBottom": {
        "doc": "上次下滑后列表和栏位都没变，说明已到底，直接换栏。实测静止噪声约 4%，真实滑动至少 36%，切栏时栏位区约 44%；带上栏位区可避免切栏后沿用上一栏的基准帧。",
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FrameUnchanged",
                "custom_recognition_param": {
                    "regions": [
                        [
                            346,
                            178,
                            590,
                            355
                        ],
                        [
                            330,
                            85,
                            455,
                            60
                        ]
                    ],
                    "max_changed_ratio": 0.15
                }
            }
        },
        "action": "DoNothing",
        "next": [
            "TeamLeaderInviteAdvance"
        ]
    },
    "TeamLeaderInviteListFits": {
        "doc": "一屏固定显示 8 人；在线人数不超过 8 时无需滑动。读不出人数时不命中，退回滑动查找。",
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^在线\\D*[0-8]$",
                "roi": [
