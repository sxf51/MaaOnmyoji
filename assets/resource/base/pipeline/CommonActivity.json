{
    "CommonActivityTask": {
        "desc": "通用：重复挑战",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountInit",
                "custom_action_param": {
                    "target_count": -1
                }
            }
        },
        "next": [
            "[JumpBack]CommonClickAuto",
            "[JumpBack]CommonActivityChallenging",
            "CommonActivityBattleFailure",
            "[JumpBack]CommonRewardItemDetail",
            "[JumpBack]CommonRewardOverflow",
            "CommonActivityBattleResult",
            "CommonActivityVictory",
            "CommonActivityInsufficientAP",
            "[Anchor]CommonActivityStage",
            "[JumpBack]CommonSoulMismatchMute",
            "[JumpBack]CommonSoulMismatch",
            "[JumpBack]CommonActivityPrepare",
            "[JumpBack]CommonBattleEnteringWait",
            "[JumpBack]CommonCutscene",
            "[JumpBack]DailyRewardPopup",
            "[JumpBack]CommonNetworkRetry",
            "[Anchor]CommonActivityAfterBattle",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "timeout": 180000,
        "doc": "通用重复挑战入口：所有状态共用一个候选列表，按出现频率排序（战斗中 > 失败/结算 > 挑战页 > 准备/载入 > 协作邀请 > 未知弹窗）。计数用原生锚点表示状态：开局为“未战斗”。",
        "anchor": {
            "CommonActivityStage": "CommonActivityStageIdle",
            "CommonActivityAfterBattle": "CommonActivityFallbackOff"
        }
    },
    "CommonActivityChallenging": {
        "pre_delay": 0,
        "post_delay": 1000,
        "desc": "重复挑战：挑战中",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageBattle"
                ]
            }
        },
        "action": "DoNothing",
        "next": [],
        "max_hit": 1800,
        "doc": "识别到战斗中：把锚点切到“已战斗”——回到挑战页走计数节点，结算页认不出时启用兜底点击。JumpBack 返回共用列表继续等待。",
        "anchor": {
            "CommonActivityStage": "CommonActivityFinishOnce",
            "CommonActivityAfterBattle": "CommonActivityAfterBattleTap"
        }
    },
    "CommonActivityBattleFailure": {
        "desc": "识别战斗失败，进入独立收尾，不累计成功次数。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DailyBattleFailed"
                ]
            }
        },
        "next": [
            "CommonActivityFailedBattleResult",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "timeout": 30000
    },
    "CommonActivityFailedBattleResult": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "CommonActivityBattleResult",
                    "DailyBattleFailed"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    1110,
                    160,
                    140,
                    340
                ]
            }
        },
        "post_delay": 1200,
        "next": [
            "CommonActivityFailedReturn",
            "CommonActivityFailedBattleResult",
            "[JumpBack]CommonCutscene",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "timeout": 30000,
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "关闭失败结算（有无继续提示都点右侧空白安全区），返回挑战页后停止重复挑战，不计数。",
        "max_hit": 5
    },
    "CommonActivityFailedReturn": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonActivityFinishOnce"
                ]
            }
        },
        "next": [
            "NativeFlowFailed"
        ]
    },
    "CommonActivityBattleResult": {
        "desc": "重复挑战：点击屏幕继续",
        "timeout": 20000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    440,
                    665,
                    400,
                    55
                ],
                "expected": [
                    "^(点?击)?(屏幕|空白区域)继续$"
                ]
            }
        },
        "action": "Click",
        "next": [
            "[JumpBack]CommonClickAuto",
            "[JumpBack]CommonActivityChallenging",
            "CommonActivityBattleFailure",
            "[JumpBack]CommonRewardItemDetail",
            "[JumpBack]CommonRewardOverflow",
            "CommonActivityBattleResult",
            "CommonActivityVictory",
            "CommonActivityInsufficientAP",
            "[Anchor]CommonActivityStage",
            "[JumpBack]CommonSoulMismatchMute",
            "[JumpBack]CommonSoulMismatch",
            "[JumpBack]CommonActivityPrepare",
            "[JumpBack]CommonBattleEnteringWait",
            "[JumpBack]CommonCutscene",
            "[JumpBack]DailyRewardPopup",
            "[JumpBack]CommonNetworkRetry",
            "[Anchor]CommonActivityAfterBattle",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "点击结算页的“点击屏幕继续”。不计数，计数在回到挑战页时进行。",
        "max_hit": 5
    },
    "CommonActivityVictory": {
        "desc": "重复挑战：胜利结算（无继续提示）",
        "doc": "胜利结算没有“点击屏幕继续”时：识别顶部胜利鼓（参考 OAS I_WIN，模板取自实机截图）或第二页“祝”字奖励袋（OAS I_REWARD），点击右侧空白安全区（OAS C_REWARD_3，避开下方奖励数字）。",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "sub_name": "CommonActivityWinDrum",
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "Common/BattleWin.png",
                                "threshold": 0.8,
                                "roi": [
                                    296,
                                    33,
                                    414,
                                    224
                                ]
                            }
                        }
                    },
                    "CommonBattleRewardBag"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    1110,
                    160,
                    140,
                    340
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 500,
        "max_hit": 8,
        "next": [
            "[JumpBack]CommonClickAuto",
            "[JumpBack]CommonActivityChallenging",
            "CommonActivityBattleFailure",
            "[JumpBack]CommonRewardItemDetail",
            "[JumpBack]CommonRewardOverflow",
            "CommonActivityBattleResult",
            "CommonActivityVictory",
            "CommonActivityInsufficientAP",
            "[Anchor]CommonActivityStage",
            "[JumpBack]CommonSoulMismatchMute",
            "[JumpBack]CommonSoulMismatch",
            "[JumpBack]CommonActivityPrepare",
            "[JumpBack]CommonBattleEnteringWait",
            "[JumpBack]CommonCutscene",
            "[JumpBack]DailyRewardPopup",
            "[JumpBack]CommonNetworkRetry",
            "[Anchor]CommonActivityAfterBattle",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
    "CommonActivityInsufficientAP": {
        "pre_delay": 0,
        "post_delay": 0,
        "desc": "重复挑战：体力或代币不足时结束",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonInsufficientAP"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "CommonActivityFinish"
        ]
    },
    "CommonActivityFinishOnce": {
        "desc": "重复挑战：完成一次挑战",
        "timeout": 20000,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonActivityChallenge"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountProgress",
                "custom_action_param": {
                    "count": 1,
                    "continue_node": "CommonActivityPreparation",
                    "finish_node": "CommonActivityFinish"
                }
            }
        },
        "next": [
            "CommonActivityPreparation"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "只经由锚点 CommonActivityStage 在战斗之后到达：识别到挑战节点的按钮文字即计一次（不依赖“点击屏幕继续”），把锚点切回“未战斗”，达到次数结束，否则进入下一轮准备。",
        "anchor": {
            "CommonActivityStage": "CommonActivityStageIdle",
            "CommonActivityAfterBattle": "CommonActivityFallbackOff"
        }
    },
    "CommonActivityPreparation": {
        "doc": "每场挑战前经过此处，重置本轮点击与战斗节点计数后直接挑战。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ResetCount",
                "custom_action_param": {
                    "nodes": [
                        "CommonActivityChallenge",
                        "CommonActivityPrepare",
                        "CommonActivityBattleResult",
                        "CommonActivityVictory",
                        "CommonActivityChallenging",
                        "CommonClickAuto",
                        "CommonBattleEnteringWait",
                        "CommonCutscene",
                        "CommonActivityAfterBattleTap",
                        "CommonRewardItemDetail",
                        "CommonSoulMismatch",
                        "CommonRewardOverflow",
                        "DailyRewardPopup",
                        "CommonNetworkRetry"
                    ],
                    "strict": true
                }
            }
        },
        "next": [
            "CommonActivityChallenge",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "timeout": 180000,
        "pre_delay": 0,
        "post_delay": 0
    },
    "CommonActivityChallenge": {
        "desc": "重复挑战：点击挑战",
        "timeout": 180000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    938,
                    473,
                    325,
                    231
                ],
                "expected": [
                    "^挑战$",
                    "^搜寻$",
                    "^开启$",
                    "^召唤$"
                ]
            }
        },
        "action": "Click",
        "post_delay": 500,
        "next": [
            "[JumpBack]CommonClickAuto",
            "[JumpBack]CommonActivityChallenging",
            "CommonActivityBattleFailure",
            "[JumpBack]CommonRewardItemDetail",
            "[JumpBack]CommonRewardOverflow",
            "CommonActivityBattleResult",
            "CommonActivityVictory",
            "CommonActivityInsufficientAP",
            "[Anchor]CommonActivityStage",
            "[JumpBack]CommonSoulMismatchMute",
            "[JumpBack]CommonSoulMismatch",
            "[JumpBack]CommonActivityPrepare",
            "[JumpBack]CommonBattleEnteringWait",
            "[JumpBack]CommonCutscene",
            "[JumpBack]DailyRewardPopup",
            "[JumpBack]CommonNetworkRetry",
            "[Anchor]CommonActivityAfterBattle",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "点击挑战按钮。点击后回到共用列表；若仍停在挑战页（点击未生效），由 CommonActivityFinishOnce 在未进入战斗时直接重点挑战，max_hit 限 3 次。",
        "max_hit": 3
    },
    "CommonActivityPrepare": {
        "desc": "重复挑战：准备",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1083,
                    526,
                    180,
                    131
                ],
                "expected": [
                    "^准备$"
                ]
            }
        },
        "action": "Click",
        "next": [],
        "pre_delay": 0,
        "post_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "点击当前活动战斗中的准备按钮。",
        "max_hit": 5
    },
    "CommonActivityFinish": {
        "pre_delay": 0,
        "post_delay": 0,
        "desc": "重复挑战：达到目标次数后结束",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountFinish"
            }
        }
    },
    "CommonActivityAfterBattleTap": {
        "desc": "重复挑战：结算兜底点击",
        "doc": "只经由锚点 CommonActivityAfterBattle 在战斗之后到达（参考 OAS completion 兜底）：结算文字、胜利鼓、奖励袋、准备、载入都没命中，且画面上没有未知弹窗、协作邀请或战斗时，每 3 秒点一次右侧空白安全区，每场最多 5 次；仍回不到挑战页则由任务超时失败，不计数。",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "CommonUnknownPopup",
                    "CommonRefuseBounty",
                    "PageBattle"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    1110,
                    160,
                    140,
                    340
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 3000,
        "max_hit": 5,
        "next": [
            "[JumpBack]CommonClickAuto",
            "[JumpBack]CommonActivityChallenging",
            "CommonActivityBattleFailure",
            "[JumpBack]CommonRewardItemDetail",
            "[JumpBack]CommonRewardOverflow",
            "CommonActivityBattleResult",
            "CommonActivityVictory",
            "CommonActivityInsufficientAP",
            "CommonActivityFinishOnce",
            "[JumpBack]CommonSoulMismatchMute",
            "[JumpBack]CommonSoulMismatch",
            "[JumpBack]CommonActivityPrepare",
            "[JumpBack]CommonBattleEnteringWait",
            "[JumpBack]CommonCutscene",
            "[JumpBack]DailyRewardPopup",
            "[JumpBack]CommonNetworkRetry",
            "CommonActivityAfterBattleTap",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "inverse": true
    },
    "CommonActivityStageIdle": {
        "doc": "锚点 CommonActivityStage 的“未战斗”状态（任务刚开始或刚计过数，或点击挑战未生效）：看到挑战页不计数，直接点击挑战；不经过准备节点，挑战的 max_hit 3 限制空点。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonActivityChallenge"
                ]
            }
        },
        "action": "DoNothing",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "CommonActivityChallenge",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
    "CommonActivityFallbackOff": {
        "doc": "锚点 CommonActivityAfterBattle 的“未战斗”状态：节点禁用，列表里直接跳过，战斗前不会兜底点击。",
        "enabled": false
    }
}
