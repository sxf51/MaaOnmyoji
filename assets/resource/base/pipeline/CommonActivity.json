{
    "CommonActivityTask": {
        "desc": "通用：重复挑战",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountInit",
                "custom_action_param": {
                    "target_count": -1
                }
            }
        },
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "CommonActivityInsufficientAP",
            "CommonActivityBattleFailure",
            "[JumpBack]CommonBattleEnteringWait",
            "[JumpBack]CommonCutscene",
            "SafeInput_CommonActivityBattleResult",
            "[JumpBack]CommonActivityPrepare",
            "[JumpBack]CommonClickAuto",
            "[JumpBack]CommonActivityChallenging",
            "CommonActivityBeforeChallenge"
        ],
        "timeout": 180000
    },
    "CommonActivityChallenge": {
        "desc": "重复挑战：点击挑战",
        "timeout": 180000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1067,
                    564,
                    212,
                    154
                ],
                "expected": [
                    "^挑战$",
                    "^搜寻$",
                    "^开启$"
                ]
            }
        },
        "action": "DoNothing",
        "post_delay": 0,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CommonActivityChallenge"
        ],
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "点击当前活动的挑战按钮，开始一轮重复挑战。"
    },
    "CommonActivityPrepare": {
        "desc": "重复挑战：准备",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1083,
                    526,
                    180,
                    131
                ],
                "expected": [
                    "^准备$"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "CommonActivityPreparationPassed",
            "[JumpBack]CommonBattleEnteringWait",
            "SafeInput_CommonActivityPrepare"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "点击当前活动战斗中的准备按钮。"
    },
    "CommonActivityChallenging": {
        "pre_delay": 0,
        "post_delay": 0,
        "desc": "重复挑战：挑战中",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageBattle"
                ]
            }
        },
        "action": "DoNothing",
        "next": []
    },
    "CommonActivityBattleResult": {
        "desc": "重复挑战：点击屏幕继续",
        "timeout": 20000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    440,
                    665,
                    400,
                    55
                ],
                "expected": [
                    "^点击(屏幕|空白区域)继续$"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CommonActivityBattleResult"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "关闭成功结算，返回挑战页后再记录成功次数。"
    },
    "CommonActivityFinishOnce": {
        "desc": "重复挑战：完成一次挑战",
        "timeout": 20000,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonActivityChallenge"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountProgress",
                "custom_action_param": {
                    "count": 1,
                    "continue_node": "CommonActivityPreparation",
                    "finish_node": "CommonActivityFinish"
                }
            }
        },
        "next": [
            "CommonActivityPreparation"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "确认成功结算已返回挑战页后，累计次数并决定继续准备或结束；后续仍检查未完成的队伍预设。"
    },
    "CommonActivityComplete": {
        "desc": "重复挑战：记录一次成功挑战",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountProgress",
                "custom_action_param": {
                    "count": 1
                }
            }
        },
        "next": [
            "CommonActivityCountDetermine"
        ]
    },
    "CommonActivityCountDetermine": {
        "desc": "重复挑战：判断是否继续挑战",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountDetermine",
                "custom_action_param": {
                    "decision_node": "CommonActivityCountDetermine",
                    "continue_node": "CommonActivityBeforeChallenge",
                    "finish_node": "CommonActivityFinish"
                }
            }
        },
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "[JumpBack]SafeInput_CommonActivityBattleResult",
            "CommonActivityBeforeChallenge"
        ]
    },
    "CommonActivityInsufficientAP": {
        "pre_delay": 0,
        "post_delay": 0,
        "desc": "重复挑战：体力或代币不足时结束",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonInsufficientAP"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "CommonActivityFinish"
        ]
    },
    "CommonActivityFinish": {
        "pre_delay": 0,
        "post_delay": 0,
        "desc": "重复挑战：达到目标次数后结束",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountFinish"
            }
        }
    },
    "CommonActivityBattleFailure": {
        "desc": "识别战斗失败，进入独立收尾，不累计成功次数。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DailyBattleFailed"
                ]
            }
        },
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CommonActivityFailedBattleResult"
        ],
        "timeout": 30000
    },
    "CommonActivityFailedBattleResult": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonActivityBattleResult"
                ]
            }
        },
        "action": "DoNothing",
        "post_delay": 0,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CommonActivityFailedBattleResult"
        ],
        "timeout": 30000,
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "关闭失败结算，返回挑战页后停止重复挑战。"
    },
    "CommonActivityFailedReturn": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonActivityFinishOnce"
                ]
            }
        },
        "next": [
            "NativeFlowFailed"
        ]
    },
    "CommonActivityPreparationPassed": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "自动准备已进入战斗或结算时，返回重复挑战流程。",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "CommonActivityChallenging",
                    "CommonActivityBattleResult",
                    "DailyBattleFailed"
                ]
            }
        },
        "action": "DoNothing",
        "next": []
    },
    "CommonActivityPreset": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "配置本任务的预设页面与返回位置，完成换队后才继续准备。",
        "enabled": false,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "NodeOverride",
                "custom_action_param": {
                    "TeamPresetContext": {
                        "recognition": {
                            "type": "And",
                            "param": {
                                "all_of": [
                                    "CommonActivityChallenge"
                                ]
                            }
                        }
                    },
                    "TeamPresetEntryText": {
                        "recognition": {
                            "param": {
                                "roi": [
                                    728,
                                    605,
                                    103,
                                    40
                                ]
                            }
                        }
                    },
                    "SafeInput_TeamPresetOpen": {
                        "action": {
                            "param": {
                                "target": [
                                    750,
                                    558,
                                    52,
                                    50
                                ]
                            }
                        }
                    }
                }
            }
        },
        "anchor": {
            "TeamPresetReturn": "CommonActivityPresetDone"
        },
        "next": [
            "TeamPresetRun"
        ],
        "max_hit": 1
    },
    "CommonActivityPresetDone": {
        "doc": "确认预设已应用并返回挑战页；换队步骤由 max_hit 限定每个任务只执行一次。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonActivityChallenge"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "CommonActivityPreparation"
        ]
    },
    "CommonActivityPreparation": {
        "doc": "每场挑战前经过此处；队伍预设启用时只在本任务首次进入时执行一次（max_hit），之后直接挑战。",
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "CommonActivityPreset",
            "SafeInput_CommonActivityChallenge"
        ],
        "timeout": 180000,
        "pre_delay": 0,
        "post_delay": 0
    },
    "CommonActivityBeforeChallenge": {
        "doc": "确认挑战页后执行未完成的队伍预设准备。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonActivityChallenge"
                ]
            }
        },
        "next": [
            "CommonActivityPreparation"
        ]
    }
}
