{
    "CommonActivityTask": {
        "desc": "通用：重复挑战",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountInit",
                "custom_action_param": {
                    "target_count": -1
                }
            }
        },
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "CommonActivityInsufficientAP",
            "CommonActivityBattleFailure",
            "[JumpBack]CommonBattleEnteringWait",
            "[JumpBack]CommonCutscene",
            "SafeInput_CommonActivityBattleResult",
            "[JumpBack]CommonActivityPrepare",
            "[JumpBack]CommonClickAuto",
            "[JumpBack]CommonActivityChallenging",
            "CommonActivityBeforeChallenge"
        ],
        "timeout": 180000
    },
    "CommonActivityChallenge": {
        "desc": "重复挑战：点击挑战",
        "timeout": 180000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    938,
                    473,
                    325,
                    231
                ],
                "expected": [
                    "^挑战$",
                    "^搜寻$",
                    "^开启$",
                    "^召唤$"
                ]
            }
        },
        "action": "DoNothing",
        "post_delay": 0,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CommonActivityChallenge"
        ],
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "点击当前活动的挑战按钮，开始一轮重复挑战。"
    },
    "CommonActivityPrepare": {
        "desc": "重复挑战：准备",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1083,
                    526,
                    180,
                    131
                ],
                "expected": [
                    "^准备$"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "CommonActivityPreparationPassed",
            "[JumpBack]CommonBattleEnteringWait",
            "SafeInput_CommonActivityPrepare"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "点击当前活动战斗中的准备按钮。"
    },
    "CommonActivityChallenging": {
        "pre_delay": 0,
        "post_delay": 1000,
        "desc": "重复挑战：挑战中",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageBattle"
                ]
            }
        },
        "action": "DoNothing",
        "next": [],
        "max_hit": 1800
    },
    "CommonActivityBattleResult": {
        "desc": "重复挑战：点击屏幕继续",
        "timeout": 20000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    440,
                    665,
                    400,
                    55
                ],
                "expected": [
                    "^(点?击)?(屏幕|空白区域)继续$"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CommonActivityBattleResult"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "关闭成功结算，返回挑战页后再记录成功次数。"
    },
    "CommonActivityFinishOnce": {
        "desc": "重复挑战：完成一次挑战",
        "timeout": 20000,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonActivityChallenge"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountProgress",
                "custom_action_param": {
                    "count": 1,
                    "continue_node": "CommonActivityPreparation",
                    "finish_node": "CommonActivityFinish"
                }
            }
        },
        "next": [
            "CommonActivityPreparation"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "点击屏幕继续后，再次识别到挑战节点的按钮文字（返回挑战页）才累计一次成功，并决定继续挑战或结束。"
    },
    "CommonActivityInsufficientAP": {
        "pre_delay": 0,
        "post_delay": 0,
        "desc": "重复挑战：体力或代币不足时结束",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonInsufficientAP"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "CommonActivityFinish"
        ]
    },
    "CommonActivityFinish": {
        "pre_delay": 0,
        "post_delay": 0,
        "desc": "重复挑战：达到目标次数后结束",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountFinish"
            }
        }
    },
    "CommonActivityBattleFailure": {
        "desc": "识别战斗失败，进入独立收尾，不累计成功次数。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DailyBattleFailed"
                ]
            }
        },
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CommonActivityFailedBattleResult"
        ],
        "timeout": 30000
    },
    "CommonActivityFailedBattleResult": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonActivityBattleResult"
                ]
            }
        },
        "action": "DoNothing",
        "post_delay": 0,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CommonActivityFailedBattleResult"
        ],
        "timeout": 30000,
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "on_error": [],
        "doc": "关闭失败结算，返回挑战页后停止重复挑战。"
    },
    "CommonActivityFailedReturn": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonActivityFinishOnce"
                ]
            }
        },
        "next": [
            "NativeFlowFailed"
        ]
    },
    "CommonActivityPreparationPassed": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "自动准备已进入战斗或结算时，返回重复挑战流程。",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "CommonActivityChallenging",
                    "CommonActivityBattleResult",
                    "DailyBattleFailed"
                ]
            }
        },
        "action": "DoNothing",
        "next": []
    },
    "CommonActivityPreparation": {
        "doc": "每场挑战前经过此处，重置本轮点击与战斗节点计数后直接挑战。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ResetCount",
                "custom_action_param": {
                    "nodes": [
                        "SafeInput_CommonActivityChallenge",
                        "SafeInput_CommonActivityPrepare",
                        "SafeInput_CommonActivityBattleResult",
                        "CommonActivityChallenging",
                        "SafeInput_CommonClickAuto",
                        "CommonBattleEnteringWait",
                        "CommonCutscene"
                    ],
                    "strict": true
                }
            }
        },
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_CommonActivityChallenge"
        ],
        "timeout": 180000,
        "pre_delay": 0,
        "post_delay": 0
    },
    "CommonActivityBeforeChallenge": {
        "doc": "确认挑战页后进入挑战前准备。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonActivityChallenge"
                ]
            }
        },
        "next": [
            "CommonActivityPreparation"
        ]
    }
}