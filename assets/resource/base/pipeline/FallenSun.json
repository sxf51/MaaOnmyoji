    },
    "FallenSunLayerSelected": {
        "doc": "确认目标层数文字及红色选中背景；由“日轮之陨层数”选项改写。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageFallenSunStage",
                    {
                        "sub_name": "FallenSunSelectedLayerText",
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "^日蚀$",
                                "roi": [
                                    128,
                                    95,
                                    140,
                                    370
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": "FallenSunSelectedLayerText",
                                "roi_offset": [
                                    -28,
                                    -8,
                                    60,
                                    16
                                ],
                                "method": 4,
                                "lower": [
                                    120,
                                    15,
                                    10
                                ],
                                "upper": [
                                    255,
                                    110,
                                    100
                                ],
                                "count": 120
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        }
    },
