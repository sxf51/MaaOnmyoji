        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "NodeOverride",
                "custom_action_param": {
                    "TeamLeaderDropStatistics": {
                        "action": {
                            "param": {
                                "custom_action_param": {
                                    "scope": "Mitama",
                                    "result_node": "DailyBattleResult"
                                }
                            }
                        }
                    }
                }
            }
        },
        "anchor": {
            "TeamLeaderFinishTarget": "FallenSunFinish",
            "TeamLeaderNoResourceTarget": "FallenSunNoResource"
        },
        "next": [
            "FallenSunBattleModeDestination",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
