{
    "FallenSunTask": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "导航到日轮之陨并选择配置的层数（默认日蚀），单人或作为队长组队，按成功结算次数重复挑战；达到次数或日轮之陨次数上限时正常结束，体力不足时停止（失败）。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountInit",
                "custom_action_param": {
                    "target_count": 10
                }
            }
        },
        "next": [
            "FallenSunNavigate",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
    "FallenSunNavigate": {
        "doc": "从当前页面进入日轮之陨层数页（御魂菜单→日轮之陨，或从八岐大蛇等御魂页签切换）；已在本副本组队房间且目标正确时（组队选项）直接续用房间。",
        "next": [
            "NativeNavigationBlocked",
            "[JumpBack]NativeResultDismiss",
            "[JumpBack]NativeDailyRewardPopup",
            "[JumpBack]NativeNavCancelNoResource",
            "[JumpBack]NativeNavConfirmExitExplore",
            "[JumpBack]NativeNavConfirmExitTeam",
            "[JumpBack]NativeNavDismissRaidTarget",
            "[JumpBack]NativeNavCancelInvite",
            "[JumpBack]NativeNavCancelCreate",
            "[JumpBack]NativeLoading",
            "FallenSunNavigationReady",
            "FallenSunTeamResume",
            "[JumpBack]NavigateFallenSun",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "timeout": 60000
    },
    "FallenSunTeamResume": {
        "doc": "小概率：任务开始时已在日轮之陨组队房间且房间目标正确，跳过锁定和预设（房间里做不了），直接进入组队入口；队友都在就直接开始，否则在当前房间邀请。",
        "enabled": false,
        "max_hit": 1,
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageTeamRoom",
                    "FallenSunRoomTargetDungeon",
                    "FallenSunRoomLayer"
