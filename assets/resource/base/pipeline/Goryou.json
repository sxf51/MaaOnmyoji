            "type": "And",
            "param": {
                "all_of": [
                    "PageGoryouStage"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "GoryouFinish",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
    "GoryouBattleEntry": {
        "doc": "开始一场新挑战前重置点击重试上限；钥匙清零时结束。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ResetCount",
