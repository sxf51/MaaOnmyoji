    },
    "GoryouWaitBattleStart": {
        "doc": "等待过场、布阵载入、准备、正式战斗或结算；仅原挑战目标仍存在时允许有界重试。",
        "next": [
            "GoryouNoKeyPopup",
            "GoryouBattleStarted",
            "[JumpBack]CommonSoulMismatch",
            "GoryouChallenge",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "timeout": 60000
    },
    "GoryouBattleStarted": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "已进入准备、战斗或结算，转入战斗处理。",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "DailyPrepare",
                    "PageBattle",
                    "DailyBattleResult",
                    "DailyBattleFailed",
                    "MitamaTreasurePopup",
                    "PageLoading",
                    "PageBattleEntering"
