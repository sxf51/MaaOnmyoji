        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": [
            "GoryouWaitBattleStart"
        ],
        "pre_delay": 0,
        "post_delay": 1000,
        "pre_wait_freezes": 0,
        "on_error": [],
