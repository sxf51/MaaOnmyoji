                        "GoryouChallenge",
                        "CommonBattleEnableAuto",
                        "CommonNetworkRetry",
                        "CommonRewardOverflow",
                        "MitamaTreasurePopup",
                        "CommonBattleMark",
                        "DailyPrepare",
                        "GoryouBattleResult",
                        "CommonBattleWait",
                        "CommonBattleEnteringWait",
                        "CommonCutscene",
                        "DailyRewardPopup",
                        "CommonRewardItemDetail",
                        "CommonSoulMismatch",
                        "CommonSoulMismatchConfirm"
                    ]
                }
            }
        },
        "next": [
            "GoryouNoKey",
            "GoryouNoKeyPopup",
            "GoryouChallenge",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "anchor": {
            "CommonBattleAuto": "CommonBattleEnableAuto"
        }
    },
    "GoryouChallengeButton": {
        "doc": "御灵挑战按钮比觉醒/御魂更靠左（文字约 x1052-1137, y600-635），ROI 左移以完整包含。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^挑战$",
                "roi": [
                    1020,
                    560,
                    200,
                    150
                ]
            }
        }
