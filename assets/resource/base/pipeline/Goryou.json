        "next": [
            "[JumpBack]MitamaTreasurePopup",
            "GoryouBattleFailure",
            "GoryouBattleResult",
            "[JumpBack]DailyRewardPopup",
            "GoryouAfterResult",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "pre_delay": 0,
        "post_delay": 600,
        "pre_wait_freezes": 0,
        "on_error": [],
        "post_wait_freezes": 0,
        "max_hit": 5
    },
