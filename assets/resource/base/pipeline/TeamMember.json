    "TeamMemberAfterAccept": {
        "doc": "刚点了接受：只看自动准备确认框和房间，候选少所以一轮很快。确认框可能不出现；4 秒内都没看到就回主循环。",
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 4000,
        "action": "DoNothing",
        "next": [
            "TeamMemberAutoReadyConfirm",
            "TeamMemberAcceptJoined",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "on_error": [
            "TeamMemberLoop"
        ]
    },
    "TeamMemberAfterResult": {
        "doc": "结算后（以及任务开始时）的短路径：只看邀请、自动准备确认框、战斗失败、后续结算画面和房间，候选少所以一轮很快，下一场的邀请不会因为主循环一轮太慢而过期。6 秒内都没看到就回主循环。",
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 6000,
        "action": "DoNothing",
        "next": [
            "TeamMemberAutoReadyConfirm",
            "TeamMemberAcceptDefault",
            "TeamMemberAccept",
            "TeamMemberWinResult",
            "TeamMemberResultSeen",
            "TeamMemberAfterResultRoom",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "on_error": [
            "TeamMemberLoop"
        ]
    },
