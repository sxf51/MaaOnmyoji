        "pre_delay": 0,
        "post_delay": 500,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "next": [
            "TeamMemberAfterAccept",
            "TeamMemberAcceptDefault",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "on_error": [
            "TeamMemberLoop"
        ],
        "doc": "昵称和目标副本都对上时优先点带齿轮的对勾（默认接受），之后不用每场再接受。 邀请条会从左侧滑入，滑动中识别到的位置不准、按钮也可能还不响应（实测日志 2026-11-13 02:23 第一次点击没生效），所以先等这一块画面静止 300ms，再点击；邀请已消失（2 秒内重新识别不到）就回主循环。",
        "max_hit": 5,
        "timeout": 2000
    },
    "TeamMemberAutoReadyConfirm": {
        "doc": "点带齿轮的对勾（默认接受）后可能弹出“…并在战前自动准备”确认框，点“确定”后回主循环。接受后先在 TeamMemberAfterAccept 里找，主循环最前面也会找一次，晚出现也能点掉。不勾“不再提示”。",
        "pre_delay": 0,
        "post_delay": 800,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "TeamMemberAutoReadyText",
                    "TeamMemberAutoReadyButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": [
            "TeamMemberLoop"
        ],
        "pre_wait_freezes": 0,
        "max_hit": 5
    },
    "TeamMemberAutoReadyText": {
        "doc": "确认框正文第二行“并在战前自动准备”（第一行可能被左侧邀请条挡住）。",
