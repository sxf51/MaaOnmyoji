{
    "TeamMemberTask": {
        "doc": "通用组队队员：在任意页面等待指定队长邀请，接受后等队长开战，完成准备、战斗和结算，再等下一次邀请。不导航、不选层，副本由队长决定。",
        "desc": "组队队员",
        "pre_delay": 0,
        "post_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountInit",
                "custom_action_param": {
                    "target_count": -1
                }
            }
        },
        "next": [
            "TeamMemberBattleEntry"
        ]
    },
    "TeamMemberBattleEntry": {
        "doc": "每场开始前重置点击和等待预算，不清零成功次数；之后先走结算后的短路径，再进主循环。",
        "pre_delay": 0,
        "post_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ResetCount",
                "custom_action_param": {
                    "nodes": [
                        "TeamMemberAcceptDefault",
                        "TeamMemberAccept",
                        "TeamMemberBattleResult",
                        "DailyPrepare",
                        "TeamMemberRoomWait",
                        "CommonBattleWait",
                        "CommonBattleEnteringWait",
                        "DailyRewardPopup",
                        "CommonBattleEnableAuto",
                        "CommonNetworkRetry",
                        "CommonRewardOverflow",
                        "MitamaTreasurePopup",
                        "TeamMemberRoomTick",
                        "TeamMemberIdleEmoteReady",
                        "TeamMemberAutoReadyConfirm",
                        "TeamMemberInBattle",
                        "TeamMemberWinResult",
                        "CommonRewardItemDetail",
                        "CommonSoulMismatch"
                    ],
                    "strict": true
                }
            }
        },
        "next": [
            "TeamMemberAfterResult"
        ]
    },
    "TeamMemberLoop": {
        "doc": "队员主循环。邀请和自动准备确认框几秒就过期，所以排在最前；其后是战斗、结算和房间等待。每轮所有候选按顺序在同一张截图上判断，越靠前越快命中。 过场等待不放进来（只等待不输入，删掉不影响流程）；御魂容量已满提示只在点完结算后出现，放在结算后的路由里。",
        "pre_delay": 0,
        "post_delay": 0,
        "action": "DoNothing",
        "next": [
            "TeamMemberAutoReadyConfirm",
            "TeamMemberAcceptDefault",
            "TeamMemberAccept",
            "TeamMemberWinResult",
            "TeamMemberResultSeen",
            "[JumpBack]MitamaTreasurePopup",
            "[JumpBack]TeamMemberInBattle",
            "[JumpBack]DailyPrepare",
            "[JumpBack]DailyRewardPopup",
            "[JumpBack]CommonBattleEnableAuto",
            "[JumpBack]CommonBattleWait",
            "[JumpBack]CommonNetworkRetry",
            "TeamMemberBecameLeader",
            "[JumpBack]TeamMemberRoomTick",
            "[JumpBack]TeamMemberIdleEmoteReady",
            "[JumpBack]TeamMemberRoomWait",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "timeout": 300000
    },
    "TeamMemberLeaderName": {
        "doc": "邀请弹窗第一行的队长昵称，任务选项写入精确匹配，前面允许 OCR 连带读到的等级数字。范围从等级图标到“跨区”标签右侧，有齿轮按钮时名字整体右移也在范围内，长名字也放得下。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^未配置队长$",
                "roi": [
                    180,
                    212,
                    400,
                    44
                ]
            }
        }
    },
    "TeamMemberInviteTarget": {
        "doc": "邀请弹窗第二行的目标副本（如“御魂悲鸣”），任务选项写入包含匹配；没填时是空正则，任何目标都接受。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "",
                "roi": [
                    180,
                    254,
                    400,
                    40
                ]
            }
        }
    },
    "TeamMemberAcceptIcon": {
        "doc": "普通接受：红叉右边的绿色对勾，只看弹窗这一行。",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    105,
                    220,
                    80,
                    75
                ],
                "method": 4,
                "lower": [
                    40,
                    140,
                    50
                ],
                "upper": [
                    130,
                    230,
                    130
                ],
                "count": 300,
                "connected": true
            }
        }
    },
    "TeamMemberAcceptDefaultIcon": {
        "doc": "默认接受：带齿轮的绿色对勾，在普通对勾右边，只有部分邀请会出现；只匹配绿勾部分。",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    200,
                    220,
                    80,
                    75
                ],
                "method": 4,
                "lower": [
                    40,
                    140,
                    50
                ],
                "upper": [
                    130,
                    230,
                    130
                ],
                "count": 250,
                "connected": true
            }
        }
    },
    "TeamMemberAccept": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "TeamMemberLeaderName",
                    "TeamMemberInviteTarget",
                    "TeamMemberAcceptIcon"
                ],
                "box_index": 2
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "pre_delay": 0,
        "post_delay": 500,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "next": [
            "TeamMemberAfterAccept",
            "TeamMemberAccept",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "on_error": [
            "TeamMemberLoop"
        ],
        "doc": "昵称和目标副本都对上、但没有齿轮对勾时点普通对勾。 邀请条会从左侧滑入，滑动中识别到的位置不准、按钮也可能还不响应（实测日志 2026-11-13 02:23 第一次点击没生效），所以先等这一块画面静止 300ms，再点击；邀请已消失（2 秒内重新识别不到）就回主循环。",
        "max_hit": 5,
        "timeout": 2000
    },
