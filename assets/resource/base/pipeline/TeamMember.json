    "TeamMemberWon": {
        "doc": "结算消失后记一次成功。一场战斗会连着出现两个结算画面（胜利、奖励），max_hit 1 保证每场只记一次，进入下一场战斗时由 TeamMemberInBattle 重新放开。队员打完不一定回房间，所以不以房间页为准。",
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DailyBattleResult"
                ]
            }
        },
        "inverse": true,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountProgress",
                "custom_action_param": {
                    "count": 1,
                    "continue_node": "TeamMemberBattleEntry",
                    "finish_node": "TeamMemberFinish"
                }
            }
        },
        "next": [
            "TeamMemberBattleEntry"
        ],
        "max_hit": 1
    },
