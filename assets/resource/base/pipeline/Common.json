    "CommonBountyInterrupt": {
        "doc": "识别任意页面上弹出的协作悬赏邀请，重置本次拒绝重试预算；关闭后回到被打断的流程。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonRefuseBounty"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ResetCount",
                "custom_action_param": {
                    "nodes": [
                        "SafeInput_CommonRefuseBounty"
                    ],
                    "strict": true
                }
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "CommonBountyClosed",
            "CommonRefuseBounty"
        ]
    },
    "CommonBountyClosed": {
        "doc": "确认协作悬赏弹窗已消失后结束中断分支；邀请自行消失时不再点击。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonRefuseBounty"
                ]
            }
        },
        "inverse": true,
        "pre_delay": 0,
        "post_delay": 0,
        "next": []
    },
    "PageBounty": {
        "doc": "优先识别遮挡当前页面的协作悬赏邀请。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonRefuseBounty"
                ]
            }
        }
    },
    "CommonBattleEnteringWait": {
        "doc": "过场或灰暗布阵载入时只等待，最多60秒；期间处理协作邀请，不点击准备或重新挑战。",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "PageLoading",
                    "PageBattleEntering"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "CommonBattleEnteringGone"
        ],
        "timeout": 60000,
        "rate_limit": 250
    },
    "CommonBattleEnteringGone": {
        "doc": "确认过场和灰暗布阵载入已消失，返回调用任务重新判断准备、正式战斗或结算。",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "PageLoading",
                    "PageBattleEntering"
                ]
            }
        },
        "inverse": true,
        "action": "DoNothing",
        "next": []
    }
}
