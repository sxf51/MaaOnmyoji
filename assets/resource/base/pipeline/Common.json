{
    "CommonBuffMenuIcon": {
        "doc": "匹配副本顶部竖排加成图标，忽略右上角状态标记；调用方需组合对应副本页面条件。",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Common/BuffMenu.png",
                "threshold": 0.9,
                "green_mask": true,
                "roi": [
                    400,
                    0,
                    210,
                    90
                ]
            }
        }
    },
