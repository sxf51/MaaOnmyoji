            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_ExitXianTing"
        ],
        "on_error": [],
        "doc": "退出闲庭，返回庭院。"
    },
    "SelectPackage": {
        "desc": "默认包名启动失败时列出可能的阴阳师包名",
        "action": {
            "type": "Command",
            "param": {
                "exec": "adb shell pm list packages | grep onmyoji"
            }
        }
    },
    "StartupUpdateText": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "资源更新",
                    "版本更新",
                    "更新资源",
                    "下载资源",
                    "资源下载",
                    "更新提示",
                    "检查更新",
                    "补丁下载"
                ],
                "roi": [
                    200,
                    100,
                    880,
                    400
                ]
            }
        }
    },
    "StartupUpdateButton": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "^更新$",
                    "^下载$",
                    "^确认$",
                    "^重试$"
                ],
                "roi": [
                    400,
