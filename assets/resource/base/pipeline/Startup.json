    },
    "ExitXianTing": {
        "desc": "退出闲庭",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    41,
                    38,
                    36,
                    33
                ],
                "template": "HomeBack.png",
                "threshold": 0.8
            }
        },
        "action": "DoNothing",
        "post_delay": 0,
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
