{
    "StartupTask": {
        "desc": "启动游戏，并依次处理更新、资源下载、启动动画、区服选择和登录",
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.netease.onmyoji.wyzymnqsd_cps"
            }
        },
        "post_delay": 3000,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "Startup"
        ],
        "on_error": [
            "StartupLaunchError"
        ]
    },
    "StartupLaunchError": {
        "doc": "启动失败的独立错误入口；保留购买保护，不与正常 next 重复路由。",
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SelectPackage"
        ]
    },
    "Startup": {
        "desc": "启动流程总入口",
        "post_wait_freezes": 300,
        "timeout": 60000,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "StartupHome",
            "[JumpBack]SafeInput_StartupCloseAnnouncement",
            "[JumpBack]SafeInput_StartupCancelIllustration",
            "[JumpBack]StartupUpdateConfirm",
            "[JumpBack]StartupDownloading",
            "startupMain",
            "[JumpBack]SafeInput_ReturnMainHomeButton",
            "[JumpBack]SafeInput_ReturnMainBackButton",
            "[JumpBack]SafeInput_CommonNetworkRetry",
            "[JumpBack]StartupSkipAnimation"
        ]
    },
    "StartupUpdateConfirm": {
        "desc": "检查更新后出现的更新、下载或重试按钮",
        "max_hit": 10,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "StartupUpdateText",
                    "StartupUpdateButton"
                ],
                "box_index": 1
            }
        },
        "action": "DoNothing",
        "post_delay": 0,
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_StartupUpdateConfirm"
        ],
        "on_error": [],
        "doc": "在已确认更新提示的窗口中点击更新、下载或重试。"
    },
    "StartupDownloading": {
        "desc": "等待更新或资源下载完成",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    31,
                    606,
                    1217,
                    110
                ],
                "expected": [
                    "正在连接服务器",
                    "资源",
                    "加载中",
                    "加载进度"
                ]
            }
        },
        "post_wait_freezes": {
            "time": 1000,
            "target": [
                240,
                570,
                800,
                140
            ]
        },
        "post_delay": 1000
    },
    "StartupSkipAnimation": {
        "desc": "点击屏幕跳过启动动画",
        "max_hit": 5,
        "action": "DoNothing",
        "post_delay": 0,
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_StartupSkipAnimation"
        ],
        "on_error": [],
        "doc": "仅点击明确识别到的跳过按钮；没有跳过标记时等待，不再盲点屏幕。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^跳过$",
                "roi": [
                    800,
                    0,
                    480,
                    180
                ]
            }
        }
    },
    "startupMain": {
        "desc": "登录界面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    456,
                    506,
                    389,
                    118
                ],
                "expected": [
                    "切换"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DisableNode",
                "custom_action_param": {
                    "node_name": "StartupSkipAnimation"
                }
            }
        },
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "StartupHome",
            "[JumpBack]SafeInput_StartupCloseAnnouncement",
            "[JumpBack]SafeInput_StartupCancelIllustration",
            "[JumpBack]StartupCheckServer",
            "[JumpBack]SafeInput_StartupOpenServerList",
            "[JumpBack]SafeInput_StartupSelectServer",
            "[JumpBack]StartupDownloading",
            "[JumpBack]SafeInput_CommonNetworkRetry"
        ]
    },
    "StartupOpenServerList": {
        "desc": "切换按钮",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    456,
                    506,
                    389,
                    118
                ],
                "expected": [
                    "切换"
                ]
            }
        },
        "action": "DoNothing",
        "post_delay": 0,
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_StartupOpenServerList"
        ],
        "on_error": [],
        "doc": "打开区服选择列表。"
    },
    "StartupSelectServer": {
        "desc": "选择区域",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    160,
                    100,
                    960,
                    520
                ],
                "expected": [
                    "[一-龥]+"
                ]
            }
        },
        "action": "DoNothing",
        "post_delay": 0,
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_StartupSelectServer"
        ],
        "on_error": [],
        "doc": "选择配置指定的区服。"
    },
    "StartupCheckServer": {
        "desc": "检查是否已选择区服",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    454,
                    509,
                    225,
                    35
                ],
                "expected": [
                    "[一-龥]+"
                ]
            }
        },
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "StartupHome",
            "SafeInput_StartupEnterGame",
            "StartupDownloading"
        ]
    },
    "StartupEnterGame": {
        "desc": "选定区服后点击进入游戏",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    430,
                    500,
                    420,
                    180
                ],
                "expected": [
                    "进入游戏"
                ]
            }
        },
        "action": "DoNothing",
        "post_delay": 0,
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_StartupEnterGame"
        ],
        "on_error": [],
        "doc": "进入已选定的服务器，等待庭院加载。"
    },
    "StartupHome": {
        "desc": "通过颜色标志、设备时间和玩家身份共同判断主界面",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [
                                    0,
                                    10,
                                    24,
                                    6
                                ],
                                "lower": [
                                    65,
                                    44,
                                    40
                                ],
                                "upper": [
                                    80,
                                    55,
                                    57
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "Custom",
                            "param": {
                                "custom_recognition": "StartupHomeIdentity"
                            }
                        }
                    }
                ],
                "box_index": 0
            }
        }
    },
    "StartupHomeTimeOCR": {
        "desc": "读取主界面左上角时间，供 StartupHomeIdentity 校验",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    198,
                    5,
                    67,
                    22
                ],
                "expected": [
                    "\\d{1,2}\\s*[:：.]\\s*\\d{2}"
                ]
            }
        }
    },
    "StartupHomeNicknameOCR": {
        "desc": "读取主界面玩家昵称，每次 Agent 运行对同一控制器只成功识别一次",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    124,
                    28,
                    172,
                    29
                ]
            }
        }
    },
    "ReturnMain": {
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "NativeNavigationBlocked",
            "NativeResultBlocked",
            "[JumpBack]NativeDailyRewardPopup",
            "[JumpBack]NativeNavCancelNoResource",
            "[JumpBack]NativeNavConfirmExitExplore",
            "[JumpBack]NativeNavConfirmExitTeam",
            "[JumpBack]NativeNavDismissRaidTarget",
            "[JumpBack]NativeNavCancelInvite",
            "[JumpBack]NativeNavCancelCreate",
            "[JumpBack]NativeLoading",
            "[JumpBack]SafeInput_StartupCloseAnnouncement",
            "[JumpBack]SafeInput_StartupCancelIllustration",
            "NativeAtHome",
            "[JumpBack]NavigateHome"
        ]
    },
    "ReturnMainHomeButton": {
        "desc": "回到主界面",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    5,
                    5,
                    400,
                    90
                ],
                "template": "Home.png",
                "threshold": 0.8
            }
        },
        "action": "DoNothing",
        "post_delay": 0,
        "pre_delay": 0,
        "pre_wait_freezes": 0,
        "post_wait_freezes": 0,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_ReturnMainHomeButton"
        ],
        "on_error": [],
        "doc": "点击首页图标，返回庭院。"
    },
    "ReturnMainBackButton": {
        "desc": "返回上一级",
