    },
    "AwakeningLayerSelected": {
        "doc": "确认目标层数的文字及红色选中背景。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageAwakeningStage",
                    "AwakeningTargetType",
                    {
                        "sub_name": "AwakeningSelectedLayerText",
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "^(拾|十)层$",
                                "roi": [
                                    125,
                                    85,
                                    120,
                                    615
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": "AwakeningSelectedLayerText",
                                "roi_offset": [
                                    -28,
                                    -8,
                                    60,
                                    16
                                ],
                                "method": 4,
                                "lower": [
                                    120,
                                    15,
                                    10
                                ],
                                "upper": [
                                    255,
                                    110,
                                    100
                                ],
                                "count": 120
                            }
                        }
                    }
                ],
                "box_index": 2
            }
        }
    },
