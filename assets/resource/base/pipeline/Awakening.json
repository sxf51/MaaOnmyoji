    "AwakeningTeamResume": {
        "doc": "组队开启时，任务开始先判断能否在当前房间续接：已在组队房间，房间下方目标与所选关卡一致，所有队友都在，就不退出房间。每个任务只判断一次。仍按选项确认加成后进入组队等待开战；锁阵容和预设只在选层页处理，这里跳过。",
        "enabled": false,
        "max_hit": 1,
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageTeamRoom",
                    "AwakeningRoomTargetDungeon",
                    "AwakeningRoomType",
                    "AwakeningRoomLayer",
                    "TeamLeaderRoomTeammate",
                    "TeamLeaderRoomTeammate2"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "NodeOverride",
                "custom_action_param": {
                    "TeamLeaderDropStatistics": {
                        "action": {
                            "param": {
                                "custom_action_param": {
                                    "scope": "Awakening",
                                    "result_node": "DailyBattleResult"
                                }
                            }
                        }
                    }
                }
            }
        },
        "anchor": {
            "TeamLeaderFinishTarget": "AwakeningFinish",
            "TeamLeaderNoResourceTarget": "AwakeningNoResource"
        },
        "next": [
            "AwakeningEnableBuff",
            "AwakeningBattleModeDestination",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
