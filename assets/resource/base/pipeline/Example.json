{
    "ExampleBezierSwipe": {
        "doc": "贝塞尔曲线滑动示例：将一条曲线拆分为多段连续直线移动",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "BezierSwipe",
                "custom_action_param": {
                    // 起点支持固定坐标 [x, y]，也支持在线段 line 上均匀随机取点
                    // 坐标均以 1280 × 720 基准分辨率为准
                    // "begin": {
                    //     "line": [
                    //         [
                    //             260,
                    //             600
                    //         ],
                    //         [
                    //             340,
                    //             600
                    //         ]
                    //     ]
                    // },
                    "begin": [
                        989,
                        343,
                        105,
                        115
                    ],
                    // 矩形区域格式为 [x, y, width, height]，终点会在区域内均匀随机选取
                    // 如果需要固定终点，则使用两个元素的 [x, y]
                    "end": [
                        374,
                        324,
                        118,
                        118
                    ],
                    // 目标总滑动时长，单位毫秒；实际时长可能略受控制器通信开销影响
                    "duration": 300,
                    // 随机延长时长的上限，单位毫秒；实际目标时长为 600～800 毫秒
                    "duration_random": 73,
                    // 曲线拆分的直线段数；数值越大越平滑，同时触摸移动调用次数也越多
                    "segments": 24,
                    // 曲线相对起终点直线的法向偏移量，单位像素；负数会向相反方向弯曲
                    "deviation": 40,
                    // 是否使用慢起步、快中段、慢收尾的 smoothstep 缓动
                    "easing": true,
                    // 随机数种子，保证每次执行的随机结果一致；不同种子会导致不同的随机结果
                    "random_seed": 42
                }
            }
        }
    },
    "ExampleNodeOverride": {
        "doc": "NodeOverride 示例：运行时覆盖 pipeline 节点配置",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "NodeOverride",
                // custom_action_param 的内容会原样传给 context.override_pipeline
                "custom_action_param": {
                    "ExampleOverrideTarget": {
                        // 此处可覆盖 enabled、next、recognition、action 等节点字段
                        "enabled": false,
                        "next": [
                            "ExampleOverrideFallback"
                        ]
                    }
                }
            }
        }
    },
    "ExampleResetCount": {
        "doc": "ResetCount 示例：清除节点在当前任务中的命中计数",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ResetCount",
                "custom_action_param": {
                    // nodes 必须是非空数组，常用于需要重新计算次数的循环流程
                    "nodes": [
                        "ExampleCountedNodeA",
                        "ExampleCountedNodeB"
                    ],
                    // false：个别节点清除失败仍返回成功；true：任一节点失败即返回失败
                    "strict": false
                }
            }
        }
    },
    // Native Pipeline examples.
    "ExampleNativeNavigateRaid": {
        "doc": "推荐：目标页优先。已在突破页直接完成，否则调用原生导航；JumpBack 返回后必须先检查目标页，不能把无条件导航放在列表首位。",
        "next": [
            "NativeAtRaid",
            "[JumpBack]NavigateRaid"
        ]
    },
    "ExampleNativeReturnHome": {
        "doc": "推荐：原生 Home/返回导航。调用 ReturnMain 即可；有 Home 时优先 Home，否则关闭弹窗或逐级返回。",
        "next": [
            "NativeAtHome",
            "[JumpBack]NavigateHome"
        ]
    },
    "ExampleNativePageRoute": {
        "doc": "原生页面路由：直接复用 Page* 识别。下一步只识别列表内页面，未知页面超时失败。",
        "next": [
            "ExampleNativeOnExplore",
            "ExampleNativeOnRaid"
        ],
        "timeout": 5000
    },
    "ExampleNativeOnExplore": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageExplore"
                ]
            }
        },
        "action": "DoNothing"
    },
    "ExampleNativeOnRaid": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageRaid"
                ]
            }
        },
        "action": "DoNothing"
    },
    "ExampleNativeExplore": {
        "doc": "推荐：调用生产入口完成初始化、找怪、战斗和成功计数。通过 ExplorationTask 的 target_count 配置次数，通过 ExplorationSelectChapter 的 expected 配置章节。",
        "next": [
            "ExplorationTask"
        ]
    },
    "ExampleNativeRaid": {
        "doc": "推荐：调用原生九宫格突破。RealmRaidTask 只用 TargetCountInit 初始化次数；每格本次任务最多尝试一次，成功后验证攻破标记再计数。",
        "next": [
            "RealmRaidTask"
        ]
    },
    "ExampleNativeDailyRewards": {
        "doc": "推荐：原生邮件→花合战任务→花合战奖励；只点击精确匹配的文字领取按钮，不点击宝箱。",
        "next": [
            "DailyRewardsTask"
        ]
    },
    "ExampleAwakeningTask": {
        "doc": "完整单人觉醒入口，默认火麒麟拾层、成功10次、锁定阵容，加成默认关闭。UI 配置见 tasks/Awakening.json：麒麟配置同时覆盖标题识别与菜单/左侧入口区域；层数配置同时覆盖目标文字和选中背景复核。成功结算返回正确副本才计数；可选加成在达到次数后关闭，结束停在觉醒层数页。",
        "next": [
            "AwakeningTask"
        ]
    },
    "ExampleNavigateAwakening": {
        "doc": "仅导航到觉醒菜单或觉醒层数页，不挑战、不初始化次数。已在觉醒时直接返回；需要选择麒麟和层数并刷本时调用 AwakeningTask。",
        "next": [
            "NavigateAwakening"
        ]
    },
    "ExampleEnsureExplorationMainline": {
        "doc": "已在探索地图时，展开右侧章节面板并切换主线，再按 ExplorationSelectChapter 配置继续选章和探索。需先初始化目标次数；完整任务优先调用 ExplorationTask。",
        "next": [
            "ExplorationEnsureMainline"
        ]
    },
    "ExampleMailClaimConfirmation": {
        "doc": "只在已显示邮件附件领取确认时调用：同时验证邮箱页面、领取邮件/附件提示和确定按钮。完整邮件领取流程使用 DailyRewardsTask；不要用此节点确认其它弹窗。",
        "next": [
            "DailyMailClaimConfirm"
        ]
    },
    "ExampleAwakeningWithPreset": {
        "doc": "觉醒换队示例：启用任务前预设，成功一次后结束。分组和队伍在 tasks/Awakening.json 的 觉醒预设分组与队伍 中配置，并同时更新共享节点的文字及选中识别；默认关闭觉醒加成，可通过 觉醒材料加成 单独开启。不要直接调用 TeamPresetRun，正式任务会配置页面上下文和返回锚点。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "NodeOverride",
                "custom_action_param": {
                    "AwakeningPreset": {"enabled": true},
                    "AwakeningTask": {"action": {"param": {"custom_action_param": {"target_count": 1}}}}
                }
            }
        },
        "next": ["AwakeningTask"]
    },
    "ExampleCountAndRouteAfterResult": {
        "doc": "计数与路由合并示例：需先初始化目标次数，且只能在确认一次成功结算并返回挑战页后执行。count 累计本次成功，continue_node 和 finish_node 必须同时配置；动作会按累计次数改写当前节点的 next，并自动将协作邀请分支放在首位。实际用法见 MitamaFinishOnce；省略这两个路由参数时仅计数，保持旧用法。",
        "recognition": {
            "type": "And",
            "param": {"all_of": ["MitamaFinishOnce"]}
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountProgress",
                "custom_action_param": {
                    "count": 1,
                    "continue_node": "MitamaChallenge",
                    "finish_node": "MitamaFinish"
                }
            }
        },
        "next": ["MitamaChallenge"]
    },
    "ExampleBountyAwareNavigation": {
        "doc": "跨页面协作邀请示例：协作邀请出现频率低，放在高频节点之后；高频节点都没命中时再走 CommonBountyInterrupt，默认拒绝并确认关闭，再通过 JumpBack 返回当前导航。最后的 CommonUnknownPopup 遇到没有规则的确定/取消弹窗时停止任务。",
        "next": ["NavigateHome", "[JumpBack]CommonBountyInterrupt", "CommonUnknownPopup"]
    },
    "ExampleControlDispatch": {
        "doc": "纯控制调度示例：已在御魂挑战页并完成准备时，初始化成功次数并重置重试预算；两步只改内存数据。最后先识别挑战目标，没命中时再检查协作邀请，成功一次后结束。完整任务仍使用 MitamaTask。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountInit",
                "custom_action_param": {"target_count": 1}
            }
        },
        "next": ["ExampleControlReset"]
    },
    "ExampleControlReset": {
        "doc": "重置挑战重试预算后进入完整的画面识别队列。只有已知的纯控制动作允许直连；视觉候选队列在末尾检查协作邀请和未知弹窗。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ResetCount",
                "custom_action_param": {"nodes": ["MitamaChallenge"], "strict": true}
            }
        },
        "next": ["MitamaChallenge", "[JumpBack]CommonBountyInterrupt", "CommonUnknownPopup"]
    },
    "ExampleRealmRaidFeatureCards": {
        "doc": "从当前页面进入个人突破；按卡片边框、五个圆圈外缘和右上角空白的原生蒙版模板选卡，再核对昵称；有标识的卡片跳过，漏点最多三次，核对本卡攻破印记才计数；不刷新、不买券。次数使用结界突破任务选项。",
        "next": ["RealmRaidTask"]
    },
    "ExampleCommonBattleWait": {
        "doc": "调用方已在战斗处理循环：优先判断失败和结算，再以 JumpBack 调用公共过场和正式战斗等待；等待返回后由调用方重新判断，结算点击和成功计数归具体玩法。",
        "next": ["[JumpBack]CommonBattleEnteringWait", "[JumpBack]CommonBattleWait"]
    },
    "ExampleMitamaRewardStatistics": {
        "doc": "完整运行1场御魂并在结算页匹配奖励模板，确认返回挑战页后累计；新模板放image/Rewards/Mitama或Common，堆叠数量规则见Rewards/README.md。实际开战前执行原任务准备，未开启网络上报。",
        "action": {"type":"Custom","param":{"custom_action":"NodeOverride","custom_action_param":{
            "MitamaTask":{"action":{"param":{"custom_action_param":{"target_count":1,"report_drops":false}}}},
            "MitamaSoloDropStatistics":{"enabled":true},"TeamLeaderDropStatistics":{"enabled":true}
        }}},
        "next": ["MitamaTask"]
    },

    "ExampleMitamaVerifiedLayer": {
        "doc": "从当前页面完整运行1场御魂，使用任务配置的目标层数；点击后验证红色选中背景，漏点最多三次。正常或异常退出按加成选项清理，不把失败计为成功。",
        "next": [
            "MitamaTask"
        ],
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "NodeOverride",
                "custom_action_param": {
                    "MitamaTask": {
                        "action": {
                            "param": {
                                "custom_action_param": {
                                    "target_count": 1
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "ExampleAwakeningFriendlyMark": {
        "doc": "完整运行1场觉醒并标记左一友方。使用任务配置的麒麟及层数；只有正式战斗才点击站位，不在准备或载入画面盲点。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "NodeOverride",
                "custom_action_param": {
                    "CommonBattleMark": {
                        "enabled": true,
                        "action": {
                            "param": {
                                "target": [
                                    205,
                                    530,
                                    60,
                                    50
                                ]
                            }
                        }
                    },
                    "AwakeningTask": {
                        "action": {
                            "param": {
                                "custom_action_param": {
                                    "target_count": 1
                                }
                            }
                        }
                    }
                }
            }
        },
        "next": [
            "AwakeningTask"
        ]
    }
}