        "doc": "点击配置的层数。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageEternitySeaStage",
                    "EternitySeaLayerText"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "next": [
            "EternitySeaSearchLayer"
        ],
        "pre_delay": 0,
        "post_delay": 1000,
        "pre_wait_freezes": 0,
        "on_error": [],
        "max_hit": 3
    },
