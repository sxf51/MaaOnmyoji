{
    "EternitySeaTask": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "导航到永生之海并选择配置的层数（默认肆层），单人或作为队长组队，按成功结算次数重复挑战；达到次数或永生之海次数上限时正常结束，体力不足时停止（失败）。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TargetCountInit",
                "custom_action_param": {
                    "target_count": 10
                }
            }
        },
        "next": [
            "EternitySeaNavigate",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
    "EternitySeaNavigate": {
        "doc": "从当前页面进入永生之海层数页（御魂菜单→永生之海，或从八岐大蛇等御魂页签切换）；已在本副本组队房间且目标正确时（组队选项）直接续用房间。",
        "next": [
            "NativeNavigationBlocked",
            "[JumpBack]NativeResultDismiss",
            "[JumpBack]NativeDailyRewardPopup",
            "[JumpBack]NativeNavCancelNoResource",
            "[JumpBack]NativeNavConfirmExitExplore",
            "[JumpBack]NativeNavConfirmExitTeam",
            "[JumpBack]NativeNavDismissRaidTarget",
            "[JumpBack]NativeNavCancelInvite",
            "[JumpBack]NativeNavCancelCreate",
            "[JumpBack]NativeLoading",
            "EternitySeaNavigationReady",
            "EternitySeaTeamResume",
            "[JumpBack]NavigateEternitySea",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "timeout": 60000
    },
    "EternitySeaTeamResume": {
        "doc": "小概率：任务开始时已在永生之海组队房间且房间目标正确，跳过锁定和预设（房间里做不了），直接进入组队入口；队友都在就直接开始，否则在当前房间邀请。",
        "enabled": false,
        "max_hit": 1,
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageTeamRoom",
                    "EternitySeaRoomTargetDungeon",
                    "EternitySeaRoomLayer"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "NodeOverride",
                "custom_action_param": {
                    "TeamLeaderDropStatistics": {
                        "action": {
                            "param": {
                                "custom_action_param": {
                                    "scope": "Mitama",
                                    "result_node": "DailyBattleResult"
                                }
                            }
                        }
                    }
                }
            }
        },
        "anchor": {
            "TeamLeaderFinishTarget": "EternitySeaFinish",
            "TeamLeaderNoResourceTarget": "EternitySeaNoResource"
        },
        "next": [
            "EternitySeaBattleModeDestination",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ]
    },
    "EternitySeaRoomTargetDungeon": {
        "doc": "组队房间底部目标为永生之海（房间底部显示“目标 永生之海 日蚀”等）。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "永生之海",
                "roi": [
                    700,
                    635,
                    420,
                    50
                ]
            }
        }
    },
    "EternitySeaRoomLayer": {
        "doc": "层数选项同时写入房间目标的层数（包含匹配）。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^未配置目标$",
                "roi": [
                    700,
                    635,
                    420,
                    50
                ]
            }
        }
    },
    "EternitySeaNavigationReady": {
        "doc": "进入永生之海层数页后选择配置的层数。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageEternitySeaStage"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "EternitySeaSearchLayer"
        ]
    },
    "EternitySeaLayerText": {
        "doc": "识别配置的层数文字（四层一屏可见无需滚动）；ROI 避开左侧鸟居图标；由“永生之海层数”选项改写。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^(肆|四)层$",
                "roi": [
                    128,
                    95,
                    140,
                    370
                ]
            }
        }
    },
    "EternitySeaLayerSelected": {
        "doc": "确认目标层数文字及红色选中背景；由“永生之海层数”选项改写。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageEternitySeaStage",
                    {
                        "sub_name": "EternitySeaSelectedLayerText",
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "^(肆|四)层$",
                                "roi": [
                                    128,
                                    95,
                                    140,
                                    370
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": "EternitySeaSelectedLayerText",
                                "roi_offset": [
                                    -28,
                                    -8,
                                    60,
                                    16
                                ],
                                "method": 4,
                                "lower": [
                                    120,
                                    15,
                                    10
                                ],
                                "upper": [
                                    255,
                                    110,
                                    100
                                ],
                                "count": 120
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        }
    },
    "EternitySeaSearchLayer": {
        "doc": "查找配置层数；选中后才进入战前准备。",
        "next": [
            "EternitySeaLayerReady",
            "EternitySeaSelectLayer",
            "[JumpBack]CommonBountyInterrupt",
            "CommonUnknownPopup"
        ],
        "timeout": 20000
    },
