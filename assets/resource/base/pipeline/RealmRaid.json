    "RealmRaidCard": {
        "doc": "原生蒙版模板搜索五个圆圈外缘、卡片边框和右上角空白；屏蔽头像、昵称、勋章内部等变化部分。模板由本项目截图裁剪。",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "RealmRaid/UnchallengedCard.png",
                "green_mask": true,
                "method": 10001,
                "threshold": 0.98,
                "roi": [
                    148,
                    146,
                    981,
                    390
                ],
                "order_by": "Vertical"
            }
        }
    },
    "RealmRaidBroken": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "RealmRaid/Broken.png",
                "roi": "RealmRaidChoose",
                "threshold": 0.8
            }
        }
    },
