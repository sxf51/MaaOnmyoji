{
    "RealmRaidTask": {
        "doc": "$realm_raid_task_doc",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RaidBattles",
                "custom_action_param": {
                    "target_count": 9
                }
            }
        }
    },
    "RealmRaidCard": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^\\d{1,2}$",
                "roi": [
                    148,
                    146,
                    317,
                    120
                ]
            }
        }
    },
    "RealmRaidBroken": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "RealmRaid/Broken.png",
                "roi": [
                    148,
                    146,
                    317,
                    120
                ],
                "threshold": 0.8
            }
        }
    },
    "RealmRaidChallenge": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^进攻$",
                "roi": [
                    643,
                    347,
                    153,
                    85
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        }
    }
}
