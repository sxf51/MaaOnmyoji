    "RealmRaidBattle": {
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "RealmRaidRetreatBegin",
            "[JumpBack]RealmRaidBattleMark",
            "RealmRaidBattleSettle"
        ],
        "timeout": 300000,
        "doc": "突破战斗快速循环：只放模板类判断。MaaFW 5.14 会对同一 next 列表中的全部 OCR 先做一次合并识别，本地日志中完整战斗列表每轮约1.2秒，导致退出与绿标最多晚1.2秒才被看到。战斗返回按钮只在正式战斗出现，因此按钮可见时只检查主动退出与绿标（二者并列，退出在前，预算未用完的场次不点绿标），都不需要时本轮不匹配，按rate_limit重试；按钮消失（准备、载入、结算、失败页）才进入RealmRaidBattleSettle做OCR判断。",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 300
    },
    "RealmRaidBattleSettle": {
        "doc": "战斗返回按钮不可见时进入：处理券不足、退出/战败后的再次挑战、失败与胜利结算、过场、准备和奖励弹窗；按钮重新出现时回到快速循环。",
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "RealmRaidBattleExitIcon"
                ]
            }
        },
        "inverse": true,
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "RealmRaidBattleNoResource",
            "RealmRaidRetreatRetry",
            "RealmRaidFailRetry",
            "RealmRaidBattleFailure",
            "SafeInput_RealmRaidBattleResult",
            "[JumpBack]CommonBattleEnteringWait",
            "[JumpBack]DailyPrepare",
            "[JumpBack]SafeInput_DailyRewardPopup",
            "RealmRaidBattleResume"
        ],
        "rate_limit": 300,
        "timeout": 180000
    },
    "RealmRaidBattleResume": {
        "doc": "战斗返回按钮已出现，回到只做模板判断的快速循环。",
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "RealmRaidBattleExitIcon"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "RealmRaidBattle"
        ]
    },
    "RealmRaidRetreatBegin": {
        "doc": "打m退n中的退出：本轮第一场开打后点左上角返回并确认退出，主动判负；最多n次，n由任务选项写入max_hit，默认0即关闭。本地实测当前版本准备阶段没有返回按钮，开打后才出现，且确认框弹出期间战斗继续，因此整条退出链去掉默认延迟。每次先重置本次退出的点击预算，不点准备、不计数。参考 runhey/OnmyojiAutoScript@2d2f6d8962a5af17c95670c5d0fb2e384b247162 tasks/RealmRaid/script_task.py::run_2 的 exit_four 与 tasks/Component/GeneralBattle/general_battle.py::run_general_battle_back（先退四再打九、在同一张卡上退出），以及 TanyaShue/MaaYYs@3f9a969 resource_pack/base/pipeline/战斗/自动结界.json 的 突破_开始重新挑战（max_hit计次、失败页再次挑战）。",
        "max_hit": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "RealmRaidBattleExitIcon"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ResetCount",
                "custom_action_param": {
                    "nodes": [
                        "SafeInput_RealmRaidRetreatExit",
                        "SafeInput_RealmRaidRetreatConfirm"
                    ],
                    "strict": true
                }
            }
        },
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_RealmRaidRetreatExit"
        ],
        "pre_delay": 0,
        "post_delay": 0
    },
    "RealmRaidBattleMark": {
        "doc": "按用户配置站位点击友方绿标，每场最多一次；与RealmRaidRetreatBegin并列且排在其后，并同样只要求战斗返回按钮（该按钮只在正式战斗出现，不再OCR底部技能栏，避免点击前多一次约0.8秒的合并OCR），因此退出预算未用完的场次总是先退出，不会点绿标。站位沿用御魂/觉醒的固定战斗镜头坐标，本地突破实战截图中友方五个式神与阴阳师位置一致。参考 runhey/OnmyojiAutoScript@2d2f6d8962a5af17c95670c5d0fb2e384b247162 tasks/Component/GeneralBattle/battle_wait.py::_bw_green_default 的每场一次思路。",
        "enabled": false,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "RealmRaidBattleExitIcon"
                ]
            }
        },
        "action": "DoNothing",
        "pre_delay": 0,
        "post_delay": 0,
        "max_hit": 1,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_RealmRaidBattleMark"
        ]
    },
    "RealmRaidRetreatExit": {
        "doc": "战斗中左上角的返回按钮；输出按钮框供区域点击。该按钮只在正式战斗出现，不再额外OCR战斗阶段，缩短首帧到点击的耗时。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "RealmRaidBattleExitIcon"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "SafeInput_RealmRaidRetreatExit"
        ]
    },
    "RealmRaidBattleExitIcon": {
        "doc": "BattleExit_6.png 由本项目1280x720个人突破实战截图裁剪按钮内圈，不含背景，实测战斗帧1.0、准备页与突破页均低于0.41；BattleExit_1~5 与ROI取自 TanyaShue/MaaYYs@3f9a969 战斗/自动结界.json 突破_重新挑战-模板匹配（MIT，许可见同目录MaaYYs-LICENSE.txt），在当前版本普通战斗背景下仅约0.80，按皮肤样式保留；与OAS I_EXIT (14,12,43,41) 为同一按钮。",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "RealmRaid/BattleExit_1.png",
                    "RealmRaid/BattleExit_2.png",
                    "RealmRaid/BattleExit_3.png",
                    "RealmRaid/BattleExit_4.png",
                    "RealmRaid/BattleExit_5.png",
                    "RealmRaid/BattleExit_6.png"
                ],
                "roi": [
                    0,
                    4,
                    77,
                    75
                ],
                "threshold": 0.8
            }
        }
    },
