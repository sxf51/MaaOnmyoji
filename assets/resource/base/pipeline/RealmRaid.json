    "RealmRaidPreset": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "配置个人突破页的预设入口与返回位置，完成换队后才开始选卡。入口在突破页右侧“队伍预设”(图标约1228,553)；预设窗口与御魂页同款，本地截图整体右移226、下移21（出战按钮728,505→954,526），窗口内分组/队伍ROI由任务选项按同样偏移写入；“全队正在使用”提示仍在屏幕原位置。",
        "enabled": false,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "NodeOverride",
                "custom_action_param": {
                    "TeamPresetContext": {
                        "recognition": {
                            "type": "And",
                            "param": {
                                "all_of": [
                                    "PageRaid"
                                ]
                            }
                        }
                    },
                    "TeamPresetEntryText": {
                        "recognition": {
                            "param": {
                                "roi": [
                                    1170,
                                    568,
                                    110,
                                    42
                                ]
                            }
                        }
                    },
                    "SafeInput_TeamPresetOpen": {
                        "action": {
                            "param": {
                                "target": [
                                    1206,
                                    532,
                                    44,
                                    42
                                ]
                            }
                        }
                    },
                    "TeamPresetOut": {
                        "recognition": {
                            "param": {
                                "roi": [
                                    894,
                                    503,
                                    120,
                                    44
                                ]
                            }
                        }
                    },
                    "TeamPresetFrameTemplate": {
                        "recognition": {
                            "param": {
                                "roi": [
                                    621,
                                    161,
                                    155,
                                    30
                                ]
                            }
                        }
                    }
                }
            }
        },
        "anchor": {
            "TeamPresetReturn": "RealmRaidPresetDone"
        },
        "next": [
            "TeamPresetRun"
        ]
    },
    "RealmRaidPresetDone": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "确认预设已应用并返回个人突破页，开始选卡。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageRaid"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
