                "custom_action_param": {}
            }
        }
    },
    "RealmRaidScan": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "[JumpBack]SafeInput_DailyRewardPopup",
            "RealmRaidNoTicket",
            "RealmRaidChoose",
            "RealmRaidExhaustedPage"
        ],
        "doc": "原生模板寻找右上角无标识的卡片；选择框由框架保存，漏点和结算验证始终引用同一张卡片。"
    },
    "RealmRaidNoTicket": {
        "pre_delay": 0,
        "post_delay": 0,
        "doc": "个人突破页右上角突破券读数为0时直接结束本轮，不再选卡和点击进攻，也不增加成功次数。计数被聊天栏等遮挡而读不出时不命中，继续原选卡流程，由进攻后的资源不足提示兜底。参考 runhey/OnmyojiAutoScript@2d2f6d8962a5af17c95670c5d0fb2e384b247162 的 tasks/RealmRaid/script_task.py::check_ticket，仅采用开战前读券数的思路，不引入保留券数基准或刷新。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PageRaid",
                    "RealmRaidTicketEmpty"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "[JumpBack]CommonBountyInterrupt",
            "RealmRaidFinish"
        ]
    },
    "RealmRaidTicketEmpty": {
        "doc": "只读右上角突破券计数区；本地个人突破截图读数为“30/30”。要求整段为0开头的分数，避免把30/30或其它数字当成无券。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^0\\s*/\\s*\\d+$",
                "roi": [
                    1130,
                    10,
                    120,
                    45
                ]
            }
        }
    },
    "RealmRaidExhausted": {
