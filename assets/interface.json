{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaOnmyoji",
    "label": "$project_name",
    "title": "$project_title",
    "icon": "favicon.ico",
    "languages": {
        "zh_cn": "language/interface_zh.json",
        "en_us": "language/interface_en.json"
    },
    "description": "$project_description",
    "contact": "$contact_info",
    "license": "MIT",
    "welcome": "$welcome_message",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/sxf51/MaaOnmyoji",
    "version": "0.0.1",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "(阴阳师|Onmyoji).*",
                // 截图及控制方式，请根据项目实际情况修改
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "PrintWindow", // 截图方式
                "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
                "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource/base"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "./resource/base"
                // "./resource/bilibili"
            ]
        }
    ],
    "agent": {
        "child_exec": "uv",
        "child_args": [
            "run",
            "python",
            "-u",
            "../agent/bootstrap.py"
        ]
    },
    "import": [
        "tasks/preset/Daily.json",
        "tasks/Startup.json",
        "tasks/Mitama.json",
        "tasks/Exploration.json",
        "tasks/RealmRaid.json",
        "tasks/DailyRewards.json",
        "tasks/Shutdown.json",
        "tasks/CommonActivity.json",
        "tasks/CurrentActivity.json"
    ]
}