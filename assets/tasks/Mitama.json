{
    "task": [
        {
            "name": "mitama",
            "label": "$mitama_task",
            "entry": "MitamaTask",
            "option": [
                "选择关卡",
                "自定义作战次数",
                "御魂掉落加成",
                "御魂锁定阵容",
                "御魂更换队伍预设",
                "是否组队",
                // "御魂奖励掉落统计",
                // "御魂掉落统计上报",
                "御魂友方绿标"
            ],
            "description": "$mitama_task_doc"
        }
    ],
    "option": {
        "选择关卡": {
            "type": "select",
            "label": "选择关卡",
            "default_case": "魂B(虚无)",
            "cases": [
                {
                    "name": "魂十(拾层)",
                    "pipeline_override": {
                        "MitamaSelectBaqin": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "拾层"
                                    ]
                                }
                            }
                        },
                        "MitamaTask": {
                            "attach": {
                                "stage_name": "魂十(拾层)"
                            }
                        }
                    }
                },
                {
                    "name": "魂土(悲鸣)",
                    "pipeline_override": {
                        "MitamaSelectBaqin": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "悲鸣"
                                    ]
                                }
                            }
                        },
                        "MitamaTask": {
                            "attach": {
                                "stage_name": "魂土(悲鸣)"
                            }
                        }
                    }
                },
                {
                    "name": "魂王(神罚)",
                    "pipeline_override": {
                        "MitamaSelectBaqin": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "神罚"
                                    ]
                                }
                            }
                        },
                        "MitamaTask": {
                            "attach": {
                                "stage_name": "魂王(神罚)"
                            }
                        }
                    }
                },
                {
                    "name": "魂B(虚无)",
                    "pipeline_override": {
                        "MitamaSelectBaqin": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "虚无"
                                    ]
                                }
                            }
                        },
                        "MitamaTask": {
                            "attach": {
                                "stage_name": "魂B(虚无)"
                            }
                        }
                    }
                }
            ]
        },
        "自定义作战次数": {
            "type": "switch",
            "label": "自定义作战次数",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {}
                },
                {
                    "name": "Yes",
                    "pipeline_override": {},
                    "option": [
                        "御魂作战次数"
                    ]
                }
            ],
            "description": "关闭时会清空体力"
        },
        "御魂作战次数": {
            "type": "input",
            "label": "$battle_count",
            "inputs": [
                {
                    "name": "作战次数",
                    "pipeline_type": "int",
                    "default": "30",
                    "pattern_msg": "请输入作战次数，如30",
                    "verify": "^[1-9]\\d*$",
                    "description": "请输入作战次数，如30"
                }
            ],
            "pipeline_override": {
                "MitamaTask": {
                    "attach": {
                        "target_count": "{作战次数}"
                    }
                }
            }
        },
        "御魂掉落加成": {
            "type": "switch",
            "label": "御魂掉落加成（任务结束时关闭）",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "MitamaEnableBuff": {
                            "enabled": false
                        },
                        "MitamaDisableBuff": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "MitamaEnableBuff": {
                            "enabled": true
                        },
                        "MitamaDisableBuff": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "御魂锁定阵容": {
            "type": "switch",
            "label": "锁定阵容（自动准备）",
            "description": "单人挑战前确认左下角阵容锁已锁定，未锁定时点击锁图标；关闭时不检查也不改变锁定状态。组队房间不经过此步骤。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "MitamaLockTeam": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "MitamaLockTeam": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "御魂更换队伍预设": {
            "type": "switch",
            "label": "更换队伍预设",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "MitamaPreset": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "MitamaPreset": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "御魂预设分组与队伍"
                    ]
                }
            ],
            "description": "开始挑战前完成分组、队伍、应用和出战确认；未找到入口或同款预设窗口时停止，不跳过换队。"
        },
        "御魂预设分组与队伍": {
            "type": "input",
            "label": "预设分组与队伍",
            "inputs": [
                {
                    "name": "分组",
                    "pipeline_type": "string",
                    "default": "默认分组",
                    "pattern_msg": "分组名称",
                    "description": "分组名称",
                    "verify": "^.*\\S.*$"
                },
                {
                    "name": "队伍",
                    "pipeline_type": "string",
                    "default": "默认队伍",
                    "pattern_msg": "队伍名称",
                    "description": "队伍名称",
                    "verify": "^.*\\S.*$"
                }
            ],
            "pipeline_override": {
                "TeamPresetSelectGroup": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "{分组}"
                            ]
                        }
                    }
                },
                "TeamPresetGroupSelected": {
                    "recognition": {
                        "param": {
                            "all_of": [
                                {
                                    "sub_name": "TeamPresetSelectedGroupText",
                                    "recognition": {
                                        "type": "OCR",
                                        "param": {
                                            "roi": [
                                                411,
                                                161,
                                                112,
                                                372
                                            ],
                                            "expected": [
                                                "{分组}"
                                            ]
                                        }
                                    }
                                },
                                {
                                    "recognition": {
                                        "type": "ColorMatch",
                                        "param": {
                                            "roi": "TeamPresetSelectedGroupText",
                                            "method": 4,
                                            "lower": [
                                                235,
                                                175,
                                                80
                                            ],
                                            "upper": [
                                                255,
                                                230,
                                                175
                                            ],
                                            "count": 50
                                        }
                                    }
                                }
                            ]
                        }
                    }
                },
                "TeamPresetSelectTeamConfigured": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "{队伍}"
                            ]
                        }
                    }
                },
                "TeamPresetApplyIcon": {
                    "recognition": {
                        "param": {
                            "all_of": [
                                {
                                    "sub_name": "TeamPresetTeamText",
                                    "recognition": {
                                        "type": "OCR",
                                        "param": {
                                            "roi": [
                                                544,
                                                160,
                                                376,
                                                320
                                            ],
                                            "expected": [
                                                "{队伍}"
                                            ]
                                        }
                                    }
                                },
                                {
                                    "recognition": {
                                        "type": "TemplateMatch",
                                        "param": {
                                            "roi": "TeamPresetTeamText",
                                            "roi_offset": [
                                                0,
                                                -5,
                                                300,
                                                15
                                            ],
                                            "template": [
                                                "TeamPreset/PresetApply.png",
                                                "TeamPreset/PresetApplySelected.png"
                                            ],
                                            "threshold": [
                                                0.8,
                                                0.9
                                            ]
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "是否组队": {
            "type": "switch",
            "label": "是否组队（待双账号联测）",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "MitamaBattleModeDestination": {
                            "next": [
                                "[JumpBack]CommonBountyInterrupt",
                                "MitamaBattleEntry"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {},
                    "option": [
                        "身份",
                        "队友"
                    ]
                }
            ]
        },
        "身份": {
            "type": "select",
            "label": "身份",
            "default_case": "队长",
            "cases": [
                {
                    "name": "队长",
                    "pipeline_override": {
                        "MitamaBattleModeDestination": {
                            "next": [
                                "[JumpBack]CommonBountyInterrupt",
                                "SafeInput_MitamaTeamLeader"
                            ]
                        },
                        "MitamaCountDetermine": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "continue_node": "MitamaLeaderBattleEntry"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "队员",
                    "pipeline_override": {
                        "MitamaBattleModeDestination": {
                            "next": [
                                "MitamaTeamMember"
                            ]
                        },
                        "MitamaCountDetermine": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "continue_node": "MitamaMemberBattleEntry"
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "队友": {
            "type": "input",
            "label": "队友",
            "inputs": [
                {
                    "name": "队友昵称",
                    "pipeline_type": "string",
                    "default": "",
                    "pattern_msg": "请输入队友昵称",
                    "description": "请输入队友昵称",
                    "verify": "^.+$"
                }
            ],
            "pipeline_override": {
                "MitamaTask": {
                    "attach": {
                        "teammate": "{队友昵称}"
                    }
                }
            }
        },
        "御魂掉落统计上报": {
            "type": "switch",
            "label": "御魂掉落统计上报",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "MitamaTask": {
                            "attach": {
                                "report_drops": false
                            }
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "MitamaTask": {
                            "attach": {
                                "report_drops": true
                            }
                        }
                    },
                    "option": [
                        "御魂掉落上报地址"
                    ]
                }
            ],
            "description": "本地统计独立开关；仅开启并配置地址后发送物品统计，不上传截图。"
        },
        "御魂掉落上报地址": {
            "type": "input",
            "label": "御魂掉落上报地址",
            "inputs": [
                {
                    "name": "御魂掉落上报地址",
                    "pipeline_type": "string",
                    "default": "",
                    "verify": "^https?://.+$"
                }
            ],
            "pipeline_override": {
                "MitamaTask": {
                    "attach": {
                        "drop_report_url": "{御魂掉落上报地址}"
                    }
                }
            }
        },
        "御魂奖励掉落统计": {
            "type": "switch",
            "label": "御魂奖励掉落统计（本地模板匹配）",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "MitamaSoloDropStatistics": {
                            "enabled": false
                        },
                        "MitamaTeamDropStatistics": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "MitamaSoloDropStatistics": {
                            "enabled": true
                        },
                        "MitamaTeamDropStatistics": {
                            "enabled": true
                        }
                    }
                }
            ],
            "description": "匹配已有模板，返回副本页后累计；识别不到的奖励不会猜测物品名称。"
        },
        "御魂友方绿标": {
            "type": "switch",
            "label": "友方绿标",
            "description": "按固定战斗镜头下的友方站位点击，每场正式战斗最多一次；默认关闭。镜头旋转或站位变化后落点可能不对应，请保持镜头固定。",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "CommonBattleMark": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "CommonBattleMark": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "御魂绿标站位"
                    ]
                }
            ]
        },
        "御魂绿标站位": {
            "type": "select",
            "label": "绿标站位",
            "default_case": "左一",
            "cases": [
                {
                    "name": "左一",
                    "pipeline_override": {
                        "SafeInput_CommonBattleMark": {
                            "action": {
                                "param": {
                                    "target": [
                                        205,
                                        530,
                                        60,
                                        50
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "左二",
                    "pipeline_override": {
                        "SafeInput_CommonBattleMark": {
                            "action": {
                                "param": {
                                    "target": [
                                        425,
                                        495,
                                        60,
                                        50
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "左三",
                    "pipeline_override": {
                        "SafeInput_CommonBattleMark": {
                            "action": {
                                "param": {
                                    "target": [
                                        614,
                                        450,
                                        45,
                                        35
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "左四",
                    "pipeline_override": {
                        "SafeInput_CommonBattleMark": {
                            "action": {
                                "param": {
                                    "target": [
                                        780,
                                        495,
                                        55,
                                        50
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "左五",
                    "pipeline_override": {
                        "SafeInput_CommonBattleMark": {
                            "action": {
                                "param": {
                                    "target": [
                                        955,
                                        495,
                                        60,
                                        50
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "阴阳师",
                    "pipeline_override": {
                        "SafeInput_CommonBattleMark": {
                            "action": {
                                "param": {
                                    "target": [
                                        585,
                                        575,
                                        60,
                                        45
                                    ]
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}