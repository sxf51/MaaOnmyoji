{
    "task": [
        {
            "name": "realm_raid",
            "label": "$realm_raid_task",
            "entry": "RealmRaidTask",
            "description": "$realm_raid_task_doc",
            "option": [
                "结界突破成功次数"
            ]
        }
    ],
    "option": {
        "结界突破成功次数": {
            "type": "input",
            "label": "本轮成功次数（最多九次，不刷新）",
            "inputs": [
                {
                    "name": "次数",
                    "pipeline_type": "int",
                    "default": "9",
                    "verify": "^[1-9]$"
                }
            ],
            "pipeline_override": {
                "RealmRaidTask": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "target_count": "{次数}"
                            }
                        }
                    }
                }
            }
        }
    }
}
