{
    "task": [
        {
            "name": "exploration",
            "label": "$exploration_task",
            "entry": "ExplorationTask",
            "option": [
                "探索作战次数",
                "探索章节"
            ],
            "description": "$exploration_task_doc"
        }
    ],
    "option": {
        "探索作战次数": {
            "type": "input",
            "label": "$battle_count",
            "inputs": [
                {
                    "name": "次数",
                    "pipeline_type": "int",
                    "default": "10",
                    "verify": "^[1-9]\\d*$"
                }
            ],
            "pipeline_override": {
                "ExplorationTask": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "target_count": "{次数}"
                            }
                        }
                    }
                }
            }
        },
        "探索章节": {
            "type": "input",
            "label": "探索地图章节名称（已在章节内时继续当前章节）",
            "inputs": [
                {
                    "name": "章节",
                    "default": "第二十八章",
                    "verify": "^第[一二三四五六七八九十百]+章$"
                }
            ],
            "pipeline_override": {
                "ExplorationSelectChapter": {
                    "recognition": {
                        "param": {
                            "expected": "{章节}"
                        }
                    }
                }
            }
        }
    }
}
