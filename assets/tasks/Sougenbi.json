        "业原火作战次数": {
            "type": "input",
            "label": "$battle_count",
            "inputs": [
                {
                    "name": "业原火作战次数",
                    "pipeline_type": "int",
                    "default": "10",
                    "pattern_msg": "请输入作战次数，达到次数或所选难度的挑战券用完时停止",
                    "verify": "^[1-9]\\d*$",
                    "description": "请输入作战次数，达到次数或所选难度的挑战券用完时停止"
                }
            ],
            "pipeline_override": {
                "SougenbiTask": {
                    "attach": {
                        "target_count": "{业原火作战次数}"
                    }
                }
            }
        },
        "业原火锁定阵容": {
            "type": "switch",
            "label": "锁定阵容（自动准备）",
            "description": "挑战前确认左下角阵容锁已锁定，未锁定时点击锁图标；关闭时不检查也不改变锁定状态。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "SougenbiLockTeam": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "SougenbiLockTeam": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "业原火更换队伍预设": {
            "type": "switch",
            "label": "更换队伍预设",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "SougenbiPreset": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "SougenbiPreset": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "业原火预设分组与队伍"
                    ]
                }
            ],
            "description": "开始挑战前选好分组和队伍并应用预设御魂，看到“全队正在使用”后：点出战（队伍须满 5 人）；分组或队伍不在当前一屏时下滑列表查找；未找到入口或同款预设窗口时停止，不跳过换队。"
        },
        "业原火预设分组与队伍": {
            "type": "input",
            "label": "预设分组与队伍",
            "inputs": [
                {
                    "name": "分组",
                    "pipeline_type": "string",
                    "default": "默认分组",
                    "pattern_msg": "分组名称",
                    "description": "分组名称",
                    "verify": "^.*\\S.*$"
                },
                {
                    "name": "队伍",
                    "pipeline_type": "string",
                    "default": "默认队伍",
                    "pattern_msg": "队伍名称",
                    "description": "队伍名称",
                    "verify": "^.*\\S.*$"
                }
            ],
            "pipeline_override": {
                "TeamPresetSelectGroup": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "{分组}"
                            ]
                        }
                    }
                },
                "TeamPresetGroupSelected": {
                    "recognition": {
                        "param": {
                            "all_of": [
                                {
                                    "sub_name": "TeamPresetSelectedGroupText",
                                    "recognition": {
                                        "type": "OCR",
                                        "param": {
                                            "roi": [
                                                411,
                                                161,
                                                112,
                                                372
                                            ],
                                            "expected": [
                                                "{分组}"
                                            ]
                                        }
                                    }
                                },
                                {
                                    "recognition": {
                                        "type": "ColorMatch",
                                        "param": {
                                            "roi": "TeamPresetSelectedGroupText",
                                            "method": 4,
                                            "lower": [
                                                235,
                                                175,
                                                80
                                            ],
                                            "upper": [
                                                255,
                                                230,
                                                175
                                            ],
                                            "count": 50
                                        }
                                    }
                                }
                            ]
                        }
                    }
                },
                "TeamPresetSelectTeamConfigured": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "{队伍}"
                            ]
                        }
                    }
                },
                "TeamPresetApplyIcon": {
                    "recognition": {
                        "param": {
                            "all_of": [
                                {
                                    "sub_name": "TeamPresetTeamText",
                                    "recognition": {
                                        "type": "OCR",
                                        "param": {
                                            "roi": [
                                                544,
                                                160,
                                                376,
                                                320
                                            ],
                                            "expected": [
                                                "{队伍}"
                                            ]
                                        }
                                    }
                                },
                                {
                                    "recognition": {
                                        "type": "TemplateMatch",
                                        "param": {
                                            "roi": "TeamPresetTeamText",
                                            "roi_offset": [
                                                0,
                                                -5,
                                                300,
                                                15
                                            ],
                                            "template": [
                                                "TeamPreset/PresetApply.png",
                                                "TeamPreset/PresetApplySelected.png"
                                            ],
                                            "threshold": [
                                                0.8,
                                                0.9
                                            ]
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "业原火友方绿标": {
            "type": "switch",
            "label": "友方绿标",
            "description": "按固定战斗镜头下的友方站位点击，每场正式战斗最多一次；默认关闭。镜头旋转或站位变化后落点可能不对应，请保持镜头固定。",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "CommonBattleMark": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "CommonBattleMark": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "业原火绿标站位"
                    ]
                }
            ]
        },
