{
    "task": [
        {
            "name": "common_activity",
            "label": "$common_activity_task",
            "entry": "CommonActivityTask",
            "option": [
                "重复挑战自定义作战次数",
                "重复挑战战斗失败处理"
            ],
            "description": "$common_activity_task_doc"
        }
    ],
    "option": {
        "重复挑战自定义作战次数": {
            "type": "switch",
            "label": "自定义作战次数",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {}
                },
                {
                    "name": "Yes",
                    "pipeline_override": {},
                    "option": [
                        "重复挑战作战次数"
                    ]
                }
            ],
            "description": "关闭时会持续挑战"
        },
        "重复挑战作战次数": {
            "type": "input",
            "label": "次数",
            "inputs": [
                {
                    "name": "作战次数",
                    "pipeline_type": "int",
                    "default": "30",
                    "pattern_msg": "请输入作战次数，如30",
                    "verify": "^[1-9]\\d*$",
                    "description": "请输入作战次数，如30"
                }
            ],
            "pipeline_override": {
                "CommonActivityTask": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "target_count": "{作战次数}"
                            }
                        }
                    }
                }
            }
        },
        "重复挑战战斗失败处理": {
            "type": "select",
            "label": "战斗失败时",
            "description": "失败的场次不计入作战次数。",
            "default_case": "失败后停止",
            "cases": [
                {
                    "name": "失败后停止",
                    "pipeline_override": {
                        "CommonActivityFailedContinue": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "失败后继续",
                    "pipeline_override": {
                        "CommonActivityFailedContinue": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "重复挑战失败继续上限"
                    ]
                }
            ]
        },
        "重复挑战失败继续上限": {
            "type": "input",
            "label": "最多失败次数（本次任务累计，用完后停止）",
            "inputs": [
                {
                    "name": "失败次数",
                    "pipeline_type": "int",
                    "default": "10",
                    "verify": "^[1-9]\\d*$",
                    "pattern_msg": "请输入失败次数上限，如10"
                }
            ],
            "pipeline_override": {
                "CommonActivityFailedContinue": {
                    "max_hit": "{失败次数}"
                }
            }
        }
    }
}
