{
    "task": [
        {
            "name": "startup",
            "label": "$startup_task",
            "entry": "StartupTask",
            "option": [
                "启动区服"
            ]
        }
    ],
    "option": {
        "启动区服": {
            "type": "input",
            "label": "区服",
            "inputs": [
                {
                    "name": "区服",
                    "label": "目标区服",
                    "pipeline_type": "string",
                    "default": "[一-龥]+",
                    "verify": "^.+$",
                    "pattern_msg": "请输入你所在的区，例如：雀之灵"
                }
            ],
            "pipeline_override": {
                "StartupSelectServer": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "{区服}"
                            ]
                        }
                    }
                },
                "StartupCheckServer": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "{区服}"
                            ]
                        }
                    }
                }
            }
        }
    }
}
