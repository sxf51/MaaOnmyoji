{
    "task": [
        {
            "name": "eternity_sea",
            "label": "$eternity_sea_task",
            "entry": "EternitySeaTask",
            "option": [
                "永生之海层数",
                "永生之海作战次数",
                "永生之海锁定阵容",
                "永生之海更换队伍预设",
                "永生之海组队",
                "永生之海友方绿标"
