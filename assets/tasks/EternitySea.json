    "option": {
        "永生之海层数": {
            "type": "select",
            "label": "层数",
            "default_case": "肆层",
            "cases": [
                {
                    "name": "壹层",
                    "pipeline_override": {
                        "EternitySeaLayerText": {
                            "recognition": {
                                "param": {
                                    "expected": "^(壹|一)层$"
                                }
                            }
                        },
                        "EternitySeaLayerSelected": {
                            "recognition": {
                                "param": {
                                    "all_of": [
                                        "PageEternitySeaStage",
                                        {
                                            "sub_name": "EternitySeaSelectedLayerText",
                                            "recognition": {
                                                "type": "OCR",
                                                "param": {
                                                    "expected": "^(壹|一)层$",
                                                    "roi": [
                                                        128,
                                                        95,
                                                        140,
                                                        370
                                                    ]
                                                }
                                            }
                                        },
                                        {
                                            "recognition": {
                                                "type": "ColorMatch",
                                                "param": {
                                                    "roi": "EternitySeaSelectedLayerText",
                                                    "roi_offset": [
                                                        -28,
                                                        -8,
                                                        60,
                                                        16
                                                    ],
                                                    "method": 4,
                                                    "lower": [
                                                        120,
                                                        15,
                                                        10
                                                    ],
                                                    "upper": [
                                                        255,
                                                        110,
